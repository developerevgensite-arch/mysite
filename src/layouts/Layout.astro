---
import "../styles/global.css";

const { title, description } = Astro.props

const isDev = Astro.url.hostname.includes("workers.dev");
---

<html lang="en">
<head>

    <meta charset="UTF-8">
        
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="google-site-verification" content="Fard5f87Hc7e7OJnhtUbm-JYNDoeQwPAOUPRcMlsfmQ" />

    <title>{title}</title>
        
    <meta
    name="description"
    content={description || "Reviews of the best hosting, VPN and WordPress tools to build fast and secure websites."}
    />
    
    {isDev ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow" />
      )}

    <meta name="theme-color" content="#ffffff">

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || "Reviews of the best hosting, VPN and WordPress tools."} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://techtoolreviews.com${Astro.url.pathname}`} />

    <link rel="canonical" href={`https://techtoolreviews.com${Astro.url.pathname}`} />
        
    <link rel="icon" type="image/svg+xml" href="/favicon2.svg" />

</head>

<body>

    <header class="header">

        <div class="logo">
        <a href="/">Tech<span>Review</span></a>
        </div>
        
        <button class="menu-toggle" aria-label="Menu">
        ☰
        </button>
        
        <nav class="menu" aria-label="Main navigation">
        
        <a href="/">Home</a>
        <a href="/hosting">Hosting</a>
        <a href="/vpn">VPN</a>
        <a href="/security">Security</a>
        <a href="/wordpress-tools">WordPress Tools</a>
        <a href="/about">About</a>
        
        </nav>
        
    </header>

<main>
<slot />
</main>

<footer class="footer">

    <nav class="footer-links">
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
    <a href="/privacy-policy">Privacy Policy</a>
    <a href="/terms-and-conditions">Terms & Conditions</a>
    <a href="/affiliate-disclosure">Affiliate Disclosure</a>
    </nav>
    
    <p class="disclosure">
        Disclosure: This page may contain affiliate links. We may earn a commission at no extra cost to you. 
    </p>
    
    <p>© 2026 TechReview. All rights reserved.</p>
    
    </footer>

    <script>

        const toggle = document.querySelector(".menu-toggle");
        const menu = document.querySelector(".menu");

        if (toggle && menu) {
        toggle.addEventListener("click", () => {
            menu.classList.toggle("show");
        });
        }
        
    </script>
    <div id="cookie-banner" class="cookie-banner hidden">
        <p>
            We use cookies to improve your experience and analyze traffic. By clicking "Accept", you agree to our use of cookies.
          <a href="/privacy-policy">Learn more</a>
        </p>
      
        <div class="cookie-buttons">
          <button id="accept-cookies" class="btn">Accept</button>
          <button id="reject-cookies" class="btn-outline">Reject</button>
        </div>
      </div>
      
<script>
const banner = document.getElementById("cookie-banner");

if (banner) {
    const consent = localStorage.getItem("cookie-consent");

    if (!consent) {
    banner.classList.remove("hidden");
    }

    const acceptBtn = document.getElementById("accept-cookies");
    const rejectBtn = document.getElementById("reject-cookies");

    if (acceptBtn) {
    acceptBtn.onclick = () => {
        localStorage.setItem("cookie-consent", "accepted");
        banner.classList.add("hidden");
    };
    }

    if (rejectBtn) {
    rejectBtn.onclick = () => {
        localStorage.setItem("cookie-consent", "rejected");
        banner.classList.add("hidden");
    };
    }
}
</script>

</body>
</html>
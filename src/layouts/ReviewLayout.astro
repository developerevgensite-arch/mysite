---
import Layout from './Layout.astro';

const { review } = Astro.props;
---

<Layout title={review.title} description={review.description}>

<section class="review-hero">

<h1>{review.title}</h1>

<p class="review-subtitle">{review.description}</p>

<div class="review-box">

<div class="review-top">

    <h2>{review.name}</h2>

    <div class="rating">
    ⭐ {review.rating}/5
    </div>

</div>
<!-- для всех кнопок на странице продукта который ссылается на партнерскую ссылку -->
{review.affiliate && review.affiliate.length > 0 ? (
    <a
    class="btn"
    href={review.affiliate}
    target="_blank"
    rel="nofollow sponsored"
    >
    Visit {review.name}
    </a>
) : (
    <span class="btn disabled">Link coming soon</span>
)}

</div>

</section>

<section class="review-content">
<slot />
</section>

<style>

/* REVIEW BOX */
.review-box{
background:#fff;
border-radius:12px;
padding:60px 30px 30px;
box-shadow:0 5px 20px rgba(0,0,0,0.05);
margin-bottom:0px;
}

/* CONTENT */
.review-content{
max-width:1000px;
margin:auto;
padding:20px;
}

.review-hero{
max-width:1000px;
margin:auto;
padding:40px 20px 0px;
}

.review-top{
display:flex;
justify-content:space-between;
align-items:center;
width:100%;
}
.review-top h2{
    margin-top: 0px;

}

/* DESCRIPTION */
.review-subtitle{
font-size:18px;
color:#555;
max-width:700px;
margin-bottom:30px;
}



/* RATING */
.rating{
font-size:22px;
font-weight:bold;
color:#2e7d32;
margin-left:auto;
transform:translateY(2px);

}

/* BUTTON */
.btn{
display:inline-block;
background:#ff8a00;
color:white;
padding:12px 20px;

border-radius:8px;
text-decoration:none;
font-weight:bold;
transition:0.2s;
min-width:150px;
text-align:center;
cursor:pointer;
box-shadow:0 4px 10px rgba(0,0,0,0.08);
}

.btn:hover{
background:#e67600;
}

.btn.disabled{
pointer-events:none;
opacity:0.6;
cursor:default;
}



</style>

</Layout>
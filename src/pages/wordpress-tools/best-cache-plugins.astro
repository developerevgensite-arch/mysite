---
import Layout from "../../layouts/Layout.astro";
import "../../styles/compare-pages.css";
import reviews from "../../data/reviews.json";
import { guides } from "../../data/guides.js";

const pathname = Astro.url.pathname.split("/").filter(Boolean);

const currentCategory = pathname[0] || "";
const currentSlug = pathname[1] || "";

const currentGuides = (guides[currentCategory] ?? [])
  .filter((item) => item.slug !== currentSlug)
  .slice(0, 4);

// 🔥 ФИЛЬТР
const categoryReviews = reviews
  .filter((item) =>
    item.category === currentCategory &&
    item.subCategory === "cache"
  )
  .sort((a, b) => (b.rating || 0) - (a.rating || 0));

const topItems = categoryReviews.slice(0, 3);

// FAQ
const faqItems = [
  {
    q: "What is a cache plugin?",
    a: "Cache plugins improve website speed by storing static versions of pages and reducing server load."
  },
  {
    q: "Do I need a cache plugin?",
    a: "Yes, cache plugins help improve loading speed and performance, especially for WordPress sites."
  },
  {
    q: "What is the best cache plugin?",
    a: "Popular options include WP Rocket, LiteSpeed Cache, and W3 Total Cache."
  },
  {
    q: "Can cache plugins break a website?",
    a: "Sometimes. Incorrect settings can cause issues, but most plugins work well with default settings."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout
  title="Best Cache Plugins for WordPress in 2026"
  description="Compare the best cache plugins to speed up your WordPress site and improve performance."
>
<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

<section class="compare-hero">
  <div class="page-container">
    <p class="compare-eyebrow">Performance Guide</p>
    <h1>Best Cache Plugins for WordPress in 2026</h1>

    <p class="compare-intro">
      Want a faster website? These cache plugins improve loading speed,
      performance, and user experience.
    </p>

    <div class="compare-cta-row">
      <a href="#top-picks" class="btn btn-primary">See Top Plugins</a>
      {topItems[0] && (
        <a href={`/${topItems[0].category}/${topItems[0].slug}`} class="btn btn-secondary">
          Read {topItems[0].name} Review →
        </a>
      )}
    </div>
  </div>
</section>

<section class="compare-content">
  <div class="page-container compare-layout">

    <article class="compare-main">

      <section class="compare-section">
        <h2>How to Choose a Cache Plugin</h2>

        <p>
          Cache plugins are essential for improving WordPress speed and performance.
          They reduce server load and deliver pages faster to visitors.
        </p>

        <p>
          Choose a plugin that is easy to configure and works well with your hosting.
          Some plugins are optimized for specific servers like LiteSpeed.
        </p>

        <p>
          Avoid using multiple cache plugins at the same time, as they can conflict
          and cause issues.
        </p>
      </section>

      <section class="compare-section" id="top-picks">
        <h2>Top Cache Plugin Picks</h2>

        <div class="compare-cards-grid">
          {topItems.map((item, index) => (
            <div class="compare-card">
              {index === 0 && <span class="compare-badge">Top Pick</span>}

              <h3>{item.name}</h3>
              <p class="compare-card-tag">{item.tag || "Cache plugin"}</p>

              <p class="compare-card-text">
                {item.summary || item.description}
              </p>

              <div class="compare-rating">★ {item.rating}/5</div>

              <div class="compare-card-actions">
                <a href={`/${item.category}/${item.slug}`} class="btn btn-secondary">
                  Read {item.name} Review →
                </a>
                <a
                  href={item.affiliate}
                  class="btn btn-primary"
                  target="_blank"
                  rel="nofollow sponsored noopener"
                >
                  Try Plugin →
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="compare-section">
        <h2>Best Cache Plugins by Use Case</h2>

        <ul class="compare-list">
          <li><strong>Best premium:</strong> WP Rocket</li>
          <li><strong>Best free:</strong> LiteSpeed Cache</li>
          <li><strong>Best advanced:</strong> W3 Total Cache</li>
        </ul>
      </section>

      <section class="compare-section">
        <h2>Final Verdict</h2>

        <p>
          Cache plugins are one of the easiest ways to speed up your WordPress site.
          Even basic caching can significantly improve load times.
        </p>

        <div class="compare-bottom-cta">
          <a
            href="/go/wp-rocket"
            class="btn btn-primary"
            target="_blank"
            rel="nofollow sponsored noopener"
          >
            Speed Up Your Site →
          </a>
        </div>
      </section>

      <section class="compare-section compare-faq-section">
        <h2>Cache Plugins FAQ</h2>

        <div class="compare-faq-list">
          {faqItems.map((item) => (
            <details class="compare-faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </section>

    </article>

    <aside class="compare-sidebar">

      <div class="compare-sidebar-box">
        <h3>Quick Summary</h3>
        <ul>
          <li>Improve website speed</li>
          <li>Reduce server load</li>
          <li>Boost SEO performance</li>
        </ul>
      </div>

      <div class="compare-sidebar-box">
        <h3>Read Next</h3>
        {currentGuides.length > 0 && (
          <ul class="compare-sidebar-links">
            {currentGuides.map((item) => (
              <li>
                <a href={`/${currentCategory}/${item.slug}`}>
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="compare-sidebar-box">
        <h3>Best Starting Point</h3>
        <p>Start with a simple cache plugin and optimize later.</p>
        <a
          href="/go/wp-rocket"
          class="btn btn-primary compare-sidebar-btn"
          target="_blank"
          rel="nofollow sponsored noopener"
        >
          Start Optimization →
        </a>
      </div>

    </aside>

  </div>
</section>

</Layout>
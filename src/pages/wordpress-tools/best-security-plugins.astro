---
import Layout from "../../layouts/Layout.astro";
import "../../styles/compare-pages.css";
import reviews from "../../data/reviews.json";
import { guides } from "../../data/guides.js";

const pathname = Astro.url.pathname.split("/").filter(Boolean);

const currentCategory = pathname[0] || "";
const currentSlug = pathname[1] || "";

const currentGuides = (guides[currentCategory] ?? [])
  .filter((item) => item.slug !== currentSlug)
  .slice(0, 4);

// 🔥 ФИЛЬТР
const categoryReviews = reviews
  .filter((item) =>
    item.category === currentCategory &&
    item.subCategory === "security"
  )
  .sort((a, b) => (b.rating || 0) - (a.rating || 0));

const topItems = categoryReviews.slice(0, 3);

// FAQ
const faqItems = [
  {
    q: "Do I need a security plugin for WordPress?",
    a: "Yes. Security plugins help protect your website from malware, brute force attacks, and vulnerabilities."
  },
  {
    q: "What is the best WordPress security plugin?",
    a: "Popular options include Wordfence, Sucuri, and iThemes Security."
  },
  {
    q: "Are free security plugins enough?",
    a: "Free versions offer basic protection, but premium versions provide advanced firewall and malware scanning features."
  },
  {
    q: "Can security plugins slow down my site?",
    a: "Some plugins may slightly affect performance, but most are optimized and safe to use."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout
  title="Best Security Plugins for WordPress in 2026"
  description="Compare the best WordPress security plugins to protect your site from malware, attacks, and hackers."
>
<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

<section class="compare-hero">
  <div class="page-container">
    <p class="compare-eyebrow">Security Guide</p>
    <h1>Best Security Plugins for WordPress in 2026</h1>

    <p class="compare-intro">
      Protect your website from hackers, malware, and attacks with these
      top WordPress security plugins.
    </p>

    <div class="compare-cta-row">
      <a href="#top-picks" class="btn btn-primary">See Top Plugins</a>
      {topItems[0] && (
        <a href={`/${topItems[0].category}/${topItems[0].slug}`} class="btn btn-secondary">
          Read {topItems[0].name} Review →
        </a>
      )}
    </div>
  </div>
</section>

<section class="compare-content">
  <div class="page-container compare-layout">

    <article class="compare-main">

      <section class="compare-section">
        <h2>How to Choose a Security Plugin</h2>

        <p>
          Security plugins protect your website from common threats such as malware,
          brute force attacks, and vulnerabilities.
        </p>

        <p>
          Choose a plugin that includes firewall protection, malware scanning,
          and login security features.
        </p>

        <p>
          Regular updates and active development are also important for maintaining
          long-term security.
        </p>
      </section>

      <section class="compare-section" id="top-picks">
        <h2>Top Security Plugin Picks</h2>

        <div class="compare-cards-grid">
          {topItems.map((item, index) => (
            <div class="compare-card">
              {index === 0 && <span class="compare-badge">Top Pick</span>}

              <h3>{item.name}</h3>
              <p class="compare-card-tag">{item.tag || "Security plugin"}</p>

              <p class="compare-card-text">
                {item.summary || item.description}
              </p>

              <div class="compare-rating">★ {item.rating}/5</div>

              <div class="compare-card-actions">
                <a href={`/${item.category}/${item.slug}`} class="btn btn-secondary">
                  Read {item.name} Review →
                </a>
                {item.affiliate ? (
                  <a
                    href={item.affiliate}
                    class="btn btn-primary"
                    target="_blank"
                    rel="nofollow sponsored noopener"
                  >
                    Try Plugin →
                  </a>
                ) : (
                  <span class="btn btn-primary disabled" aria-disabled="true">Link coming soon</span>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="compare-section">
        <h2>Best Security Plugins by Use Case</h2>

        <ul class="compare-list">
          <li><strong>Best overall:</strong> Wordfence</li>
          <li><strong>Best cloud protection:</strong> Sucuri</li>
          <li><strong>Best beginner option:</strong> iThemes Security</li>
        </ul>
      </section>

      <section class="compare-section">
        <h2>Final Verdict</h2>

        <p>
          Security plugins are essential for protecting your WordPress website.
          Even basic protection can prevent common attacks and data loss.
        </p>

        <div class="compare-bottom-cta">
          <span class="btn btn-primary disabled" aria-disabled="true">Link coming soon</span>
        </div>
      </section>

      <section class="compare-section compare-faq-section">
        <h2>Security Plugins FAQ</h2>

        <div class="compare-faq-list">
          {faqItems.map((item) => (
            <details class="compare-faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </section>

    </article>

    <aside class="compare-sidebar">

      <div class="compare-sidebar-box">
        <h3>Quick Summary</h3>
        <ul>
          <li>Protect your website</li>
          <li>Prevent attacks and malware</li>
          <li>Improve website safety</li>
        </ul>
      </div>

      <div class="compare-sidebar-box">
        <h3>Read Next</h3>
        {currentGuides.length > 0 && (
          <ul class="compare-sidebar-links">
            {currentGuides.map((item) => (
              <li>
                <a href={`/${currentCategory}/${item.slug}`}>
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="compare-sidebar-box">
        <h3>Best Starting Point</h3>
        <p>Start with a basic security plugin and upgrade later.</p>
        <span class="btn btn-primary compare-sidebar-btn disabled" aria-disabled="true">Link coming soon</span>
      </div>

    </aside>

  </div>
</section>

</Layout>

---
// Category page (WordPress tools)

import Layout from "../../layouts/Layout.astro";
import reviews from "../../data/reviews.json";

const wpReviews = reviews
  .filter((review) => review.category === "wordpress-tools")
  .sort((a, b) => b.rating - a.rating);

// FAQ
const faqItems = [
  {
    q: "What WordPress tools do I need to launch a site?",
    a: "At minimum, you need hosting, a theme, and a few essential plugins like SEO, caching, and security tools."
  },
  {
    q: "Are page builders like Elementor bad for speed?",
    a: "They can add some overhead, but with proper hosting and optimization, Elementor works well for most sites."
  },
  {
    q: "How many plugins is too many?",
    a: "There is no fixed number, but generally 5–15 well-coded plugins is safe. Avoid installing unnecessary plugins."
  },
  {
    q: "Do I need a dedicated SEO plugin?",
    a: "Yes. SEO plugins help optimize titles, meta descriptions, and technical SEO, improving visibility in search engines."
  },
  {
    q: "What’s the best way to back up a WordPress site?",
    a: "Use a backup plugin or your hosting provider’s backup system to regularly save your website data."
  },
  {
    q: "How do I avoid plugin conflicts?",
    a: "Use well-maintained plugins, keep them updated, and avoid installing multiple plugins with the same functionality."
  }
];

// GUIDES (самое важное)
const guides = [
  { slug: "best-wordpress-plugins", title: "Best WordPress Plugins" },
  { slug: "best-elementor-addons", title: "Best Elementor Addons" },
  { slug: "best-seo-plugins", title: "Best SEO Plugins" }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a
    }
  }))
};
---

<Layout title="Best WordPress Tools">

<section class="category-hero">

<h1>Best WordPress Tools & Plugins</h1>

<p class="category-text">
  Looking for the best WordPress tools? We selected top plugins, builders, and tools
  to help you create fast, secure, and professional websites.
</p>

</section>

<section class="tools-grid">

  {wpReviews.map((item) => (
    <article class="tool-card">

      {item.badge && <div class="card-badge">{item.badge}</div>}

      <h2>{item.name}</h2>

      {item.tag && <p class="card-tag">{item.tag}</p>}

      <p>{item.description}</p>

      <div class="tool-meta">
        <span class="rating">⭐ {item.rating} / 5 (Our score)</span>
      </div>

      <div class="buttons">

        <a href={`/wordpress-tools/${item.slug}`} class="btn btn-secondary">
          Read Review →
        </a>

        <a href={item.affiliate} class="btn btn-primary" target="_blank" rel="nofollow sponsored noopener">
          Try Now →
        </a>

      </div>

    </article>
  ))}

</section>

<section class="container-text">

  <h2>How to Choose WordPress Tools</h2>

  <p>
  WordPress tools help you build and manage your website without coding.
  Choosing the right tools improves performance, SEO, and design.
  </p>

  <p>
  It is better to use a few high-quality plugins instead of many low-quality ones.
  Focus on performance, compatibility, and long-term support.
  </p>

</section>

<section class="container-text">

  <h2>Best Tools by Use Case</h2>

  <ul class="use-cases">
    <li><strong>Best builder:</strong> Elementor — visual page builder</li>
    <li><strong>Best SEO:</strong> Rank Math — optimization tools</li>
    <li><strong>Best performance:</strong> LiteSpeed Cache — fast loading</li>
  </ul>

</section>

<!-- FAQ -->
<section class="faq" aria-label="WordPress FAQ">
  <div class="faq-inner">
    <h2>WordPress Tools FAQ</h2>

    <p class="faq-subtitle">
      Quick answers to common questions about WordPress plugins, builders, and tools.
    </p>

    <div class="faq-list">
      {faqItems.map((item) => (
        <details class="faq-item">
          <summary class="faq-question">
            <span>{item.q}</span>
            <span class="faq-icon">+</span>
          </summary>
          <div class="faq-answer">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- GUIDES -->
<section class="guides-section-box">

  <div class="faq-inner">

    <h2>WordPress Guides</h2>

    <div class="guides-grid">
      {guides.map((item) => (
        <a href={`/wordpress-tools/${item.slug}`} class="guide-card">
          <h3>{item.title}</h3>
          <span>Read Guide →</span>
        </a>
      ))}
    </div>

  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

<style>

.category-hero{
max-width:900px;
margin:auto;
padding:20px 20px 10px;
text-align:left;
}

.category-subtitle{
font-size:18px;
color:#555;
margin-top:10px;
}

.container-text{
  max-width:900px;
  margin:0 auto 30px;
  padding:0 20px;
}

.use-cases{
  margin-top:10px;
  line-height:1.8;
  color:#444;
}

.card-tag{
  font-size:14px;
  color:#ff8a00;
  font-weight:600;
  margin-bottom:6px;
}

.card-badge{
  position:absolute;
  top:12px;
  right:12px;
  background:#22c55e;
  color:#fff;
  padding:5px 9px;
  font-size:12px;
  border-radius:6px;
}

.tools-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
gap:20px;
margin:20px auto 40px;
max-width:1000px;
padding:0 20px;
}

.tool-card{
position:relative;
background:#fff;
border-radius:12px;
padding:20px;
box-shadow:0 5px 20px rgba(0,0,0,0.04);
display:flex;
flex-direction:column;
gap:10px;
}

.tool-meta{
font-size:14px;
color:#444;
}

.rating{
font-weight:bold;
color:#2e7d32;
}

.buttons{
  margin-top:auto;
  display:flex;
  flex-direction:column;
  gap:10px;
}

.btn{
margin-top:auto;
align-self:flex-start;
}


/* faq */
.faq{
max-width:1000px;
margin:0 auto 40px;
padding:0 20px;
}

.faq-inner{
background:white;
border-radius:12px;
box-shadow:0 5px 20px rgba(0,0,0,0.04);
padding:22px;
}

.faq-inner h2{
margin-top:0;
margin-bottom:10px;
}

.faq-subtitle{
margin:0 0 18px;
font-size:16px;
color:#555;
max-width:760px;
}

.faq-list{
display:flex;
flex-direction:column;
gap:10px;
}

.faq-item{
border:1px solid #eceff3;
border-radius:10px;
background:#fff;
overflow:hidden;
}

.faq-question{
list-style:none;
display:flex;
align-items:center;
justify-content:space-between;
gap:16px;
padding:14px 16px;
cursor:pointer;
font-weight:700;
color:#111827;
}

.faq-question::-webkit-details-marker{
display:none;
}

.faq-icon{
width:28px;
height:28px;
border-radius:8px;
display:grid;
place-items:center;
background:#fff2e5;
color:#b45309;
font-weight:800;
flex:0 0 auto;
transition:transform .15s ease;
}

.faq-item[open] .faq-icon{
transform:rotate(45deg);
}

.faq-answer{
padding:0 16px 16px;
color:#4b5563;
}

.faq-answer p{
margin:0;
}

.guides-section-box{
  max-width:1000px;
  margin:80px auto 0px;
  padding:20px 20px;
}

.guides-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:16px;
  margin-top:20px;
}

.guide-card{
  background:#f9fafb;
  padding:18px;
  border-radius:10px;
  text-decoration:none;
  color:#111;
  border:1px solid #eef1f5;
  transition:0.2s;
  display:block;
}

.guide-card:hover{
  background:#fff;
  transform:translateY(-3px);
  box-shadow:0 8px 20px rgba(0,0,0,0.06);
}

.guide-card h3{
  margin:0 0 8px;
  font-size:16px;
}

.guide-card span{
  color:#ff8a00;
  font-weight:600;
  font-size:14px;
}

</style>

</Layout>
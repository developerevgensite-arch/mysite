---
// Category page (wordpress)

import Layout from "../../layouts/Layout.astro";
import reviews from "../../data/reviews.json";

const wpTools = reviews
  .filter((review) => review.category === "wordpress-tools")
  .sort((a, b) => b.rating - a.rating);

const faqItems = [
  {
    q: "What WordPress tools do I need to launch a site?",
    a: "Most sites need a good theme, a page builder (optional), a caching/performance plugin, SEO basics, security hardening, and backups. Pick fewer, higher-quality plugins to avoid bloat."
  },
  {
    q: "Are page builders like Elementor bad for speed?",
    a: "They can be fast if you keep layouts simple, use optimized hosting, caching, and avoid heavy add-ons. The biggest speed wins usually come from hosting, caching, image optimization, and reducing unused plugins."
  },
  {
    q: "How many plugins is too many?",
    a: "There is no perfect number, but more plugins means more updates, potential conflicts, and overhead. Focus on reputable plugins that replace multiple smaller ones and remove anything you don’t use."
  },
  {
    q: "Do I need a dedicated SEO plugin?",
    a: "Often yes. An SEO plugin helps manage titles, meta descriptions, sitemaps, schema, and indexing controls. However, it won’t replace good content, internal links, and fast page speed."
  },
  {
    q: "What’s the best way to back up a WordPress site?",
    a: "Use automated off-site backups (cloud storage), keep multiple restore points, and test restores. A good host backup is helpful, but independent backups give you more control."
  },
  {
    q: "How do I avoid plugin conflicts?",
    a: "Keep WordPress/core/theme/plugins updated, avoid abandoned plugins, and test changes on staging if possible. If something breaks, disable recently added plugins first to isolate the issue."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a
    }
  }))
};
---

<Layout title="Best WordPress Tools">

<section class="category-hero">

<h1>Best WordPress Tools</h1>

<p class="category-subtitle">
Discover the best plugins and builders to design, optimize and grow WordPress sites.
</p>

</section>

<section class="tools-grid">

  {wpTools.map((item) => (
    <article class="tool-card">
      {item.badge && <div class="card-badge">{item.badge}</div>}
      <h2>{item.name}</h2>
      {item.tag && <p class="card-tag">{item.tag}</p>}
      <p>{item.description}</p>
  
      <div class="tool-meta">
        <span class="rating">⭐ {item.rating} / 5 (Our score)</span>
      </div>
  
      <div class="buttons">
        <a href={`/wordpress-tools/${item.slug}`} class="btn btn-secondary">
          Read Review →
        </a>
  
        <a href={item.affiliate} class="btn btn-primary" target="_blank" rel="nofollow sponsored noopener">
          Check Tool →
        </a>
      </div>
    </article>
  ))}
  
  </section>

<section class="container-text">

<h2>How to Choose the Best WordPress Tools</h2>

<p>
The best WordPress setup depends on what you want to build. Some tools help you design pages faster, while others improve SEO, speed, backups or security.
</p>

<p>
A good rule is to use fewer tools, but choose the ones that solve real problems. Too many plugins can make your site slower and harder to maintain.
</p>

</section>

<section class="container-text">

<h2>Best WordPress Tools by Use Case</h2>

<ul class="use-cases">
  <li><strong>Best for page building:</strong> Elementor — flexible visual builder for beginners and professionals</li>
  <li><strong>Best for site growth:</strong> tools that improve SEO, speed and lead generation</li>
  <li><strong>Best overall value:</strong> simple plugins with clear setup and reliable support</li>
</ul>

</section>


<section class="faq" aria-label="WordPress tools FAQ">
  <div class="faq-inner">
    <h2>WordPress Tools FAQ</h2>
    <p class="faq-subtitle">
      Quick answers to common questions about WordPress plugins, builders and performance.
    </p>

    <div class="faq-list">
      {faqItems.map((item) => (
        <details class="faq-item">
          <summary class="faq-question">
            <span>{item.q}</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-answer">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

<style>

.category-hero{
max-width:900px;
margin:auto;
padding:20px 20px 10px;
text-align:left;
}

.category-subtitle{
font-size:18px;
color:#555;
margin-top:10px;
}

.container-text{
  max-width:900px;
  margin:0 auto 30px;
  padding:0 20px;
}

.use-cases{
  margin-top:10px;
  line-height:1.8;
  color:#444;
}

.card-tag{
  font-size:14px;
  color:#ff8a00;
  font-weight:600;
  margin-bottom:6px;
}

.card-badge{
  position:absolute;
  top:12px;
  right:12px;
  background:#22c55e;
  color:#fff;
  padding:5px 9px;
  font-size:12px;
  border-radius:6px;
}

.tools-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
gap:20px;
margin:20px auto 40px;
max-width:1000px;
padding:0 20px;
}

.tool-card{
position:relative;
background:#fff;
border-radius:12px;
padding:20px;
box-shadow:0 5px 20px rgba(0,0,0,0.04);
display:flex;
flex-direction:column;
gap:10px;
}

.tool-meta{
font-size:14px;
color:#444;
}

.rating{
font-weight:bold;
color:#2e7d32;
}

.buttons{
  margin-top:auto;
  display:flex;
  flex-direction:column;
  gap:10px;
}

.btn{
margin-top:auto;
align-self:flex-start;
}


/* faq */
.faq{
max-width:1000px;
margin:0 auto 40px;
padding:0 20px;
}

.faq-inner{
background:white;
border-radius:12px;
box-shadow:0 5px 20px rgba(0,0,0,0.04);
padding:22px;
}

.faq-inner h2{
margin-top:0;
margin-bottom:10px;
}

.faq-subtitle{
margin:0 0 18px;
font-size:16px;
color:#555;
max-width:760px;
}

.faq-list{
display:flex;
flex-direction:column;
gap:10px;
}

.faq-item{
border:1px solid #eceff3;
border-radius:10px;
background:#fff;
overflow:hidden;
}

.faq-question{
list-style:none;
display:flex;
align-items:center;
justify-content:space-between;
gap:16px;
padding:14px 16px;
cursor:pointer;
font-weight:700;
color:#111827;
}

.faq-question::-webkit-details-marker{
display:none;
}

.faq-icon{
width:28px;
height:28px;
border-radius:8px;
display:grid;
place-items:center;
background:#fff2e5;
color:#b45309;
font-weight:800;
flex:0 0 auto;
transition:transform .15s ease;
}

.faq-item[open] .faq-icon{
transform:rotate(45deg);
}

.faq-answer{
padding:0 16px 16px;
color:#4b5563;
}

.faq-answer p{
margin:0;
}

</style>

</Layout>
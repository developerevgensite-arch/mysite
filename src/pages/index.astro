---
import Layout from '../layouts/Layout.astro';
import reviews from '../data/reviews.json';

const hosting = reviews.filter(r => r.category === "hosting");
const vpn = reviews.filter(r => r.category === "vpn");
const wordpress = reviews.filter(r => r.category === "wordpress-tools");
const security = reviews.filter(r => r.category === "security");
---

<Layout title="Best Hosting, VPN and WordPress Tools Reviews">

<section class="hero hero-grid">

<div class="hero-text">

<h1>Best Digital Tools and Services</h1>

<p class="hero-subtitle">
    We review hosting, VPN and digital tools to help you stay secure online, work on the internet and choose the right tools for your needs.
</p>

<div class="hero-buttons">

<a href="/hosting" class="btn hero-btn">
See Best Hosting
</a>

<a href="/vpn" class="btn hero-btn-outline">
Best VPN Tools
</a>

</div>

</div>

<div class="hero-image">
<img src="/hero-tools.png" alt="Digital tools illustration">
</div>

</section>

<!-- ✅ NEW: TRUST BLOCK -->
<section class="trust-block">

<h2>Why Trust TechReview?</h2>

<ul>
<li>✔ Independent reviews based on real testing</li>
<li>✔ No hidden promotions — we recommend only what works</li>
<li>✔ Clear comparisons and honest pros & cons</li>
<li>✔ Regularly updated with latest data</li>
</ul>

</section>

<section class="intro-text">

<h2>Independent Reviews of Digital Tools</h2>

<p>
    Our website provides independent reviews of popular digital tools including
    web hosting, VPN services and WordPress plugins. We carefully analyze performance,
    pricing, features and usability to help you choose the best tools for your needs.
    </p>
<!-- ✅ NEW: SEO TEXT -->
<p>
Choosing the right digital tools can be difficult. There are hundreds of hosting providers,
VPN services and WordPress plugins available online. At TechReview, we simplify this process
by testing and comparing the most popular tools, so you can quickly find the best option
for your needs.
</p>

<p>
Whether you're building your first website, improving your online security, or looking for
better performance, our detailed reviews will help you make confident decisions.
</p>

</section>

<section class="featured-hosting">

<div class="featured-card">

<div class="featured-badge">
Top Recommended
</div>

<h2>Top Recommended Tools</h2>

<p>
    Find and compare the best hosting, VPN, security and WordPress tools for your 
    websites, online projects and everyday digital life.
</p>

<a href="#hosting" class="btn">
Explore Reviews
</a>

</div>

</section>

<!-- ✅ NEW: TEXT BEFORE HOSTING -->
<section class="section-intro">
<p>
Below are some of the best digital tools including hosting, VPN, security and WordPress tools. Click any review to see detailed comparisons, pros, cons and our recommendations.
</p>
</section>

<h2 id="hosting">Best Hosting</h2>

<div class="tools-grid">

{hosting.map((item) => (

<div class="tool-card">

<h3>{item.name}</h3>

<!-- ⭐ Рейтинг -->
<div class="tool-rating">
  ⭐ {item.rating}/5
</div>

<!-- 🏆 Бейдж -->
{item.tag && (
  <div class="tool-badge">
    🏆 {item.tag}
  </div>
)}


<p>
{item.description}
</p>

<a href={`/${item.category}/${item.slug}`} class="btn">
    See Details →
</a>

</div>

))}

</div>


<h2>Best VPN</h2>

<div class="tools-grid">

{vpn.map((item) => (

<div class="tool-card">

<h3>{item.name}</h3>

<!-- ⭐ Рейтинг -->
<div class="tool-rating">
  ⭐ {item.rating}/5
</div>

<!-- 🏆 Бейдж -->

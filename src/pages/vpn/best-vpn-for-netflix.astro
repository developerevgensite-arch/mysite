---
import Layout from "../../layouts/Layout.astro";
import "../../styles/compare-pages.css"; 
import reviews from "../../data/reviews.json";
import { guides } from "../../data/guides.js";

const pathname = Astro.url.pathname.split("/").filter(Boolean);

const currentCategory = pathname[0] || ""; // vpn
const currentSlug = pathname[1] || "";     // best-vpn-for-netflix

const currentGuides = (guides[currentCategory] ?? [])
  .filter((item) => item.slug !== currentSlug)
  .slice(0, 4);

const vpnReviews = reviews
  .filter((item) => item.category === currentCategory)
  .sort((a, b) => (b.rating || 0) - (a.rating || 0));

const topItems = vpnReviews.slice(0, 2);

const faqItems = [
  {
    q: "Which VPN works best for Netflix?",
    a: "Top VPNs like NordVPN and CyberGhost are often recommended for Netflix due to their fast speeds and ability to access different regions."
  },
  {
    q: "Can a VPN unblock Netflix in other countries?",
    a: "Yes, a VPN can help access different Netflix libraries by connecting to servers in other countries."
  },
  {
    q: "Will using a VPN affect streaming quality?",
    a: "A VPN can slightly reduce speed, but high-quality providers support HD and 4K streaming."
  },
  {
    q: "Is it legal to use a VPN for Netflix?",
    a: "Using a VPN is legal in most countries, but it may go against Netflix’s terms of service."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout
  title="Best VPN for Netflix in 2026"
  description="Compare the best VPNs for Netflix: speed, streaming performance, and global access."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

  <section class="compare-hero">
    <div class="page-container">
      <p class="compare-eyebrow">VPN Guide</p>
      <h1>Best VPN for Netflix in 2026</h1>
      <p class="compare-intro">
        Want to watch Netflix content from different countries? We tested popular VPN services
        to find the best options for streaming, speed, and reliability.
      </p>

      <div class="compare-cta-row">
        <a href="#top-picks" class="btn btn-primary">See Top Picks</a>
        {topItems[0] && (
          <a href={`/${topItems[0].category}/${topItems[0].slug}`} class="btn btn-secondary">
            Read {topItems[0].name} Review →
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="compare-content">
    <div class="page-container compare-layout">
      <article class="compare-main">

        <section class="compare-section">
          <h2>How to Choose the Best VPN for Netflix</h2>
          <p>
            Not every VPN works with Netflix. The best VPN should offer fast speeds,
            stable connections, and servers optimized for streaming.
          </p>
          <p>
            Speed is critical for streaming. Look for VPNs with modern protocols
            and servers close to your location.
          </p>
          <p>
            A large server network helps you find working servers when some get blocked.
          </p>
        </section>

        <section class="compare-section" id="top-picks">
          <h2>Our Top {currentCategory.replace("-", " ")} Picks</h2>
          <p class="compare-note">
            These VPNs are currently the best options for streaming.
          </p>

          <div class="compare-cards-grid">
            {topItems.map((item, index) => (
              <div class="compare-card">
                {index === 0 && <span class="compare-badge">Top Pick</span>}
                <h3>{item.name}</h3>
                <p class="compare-card-tag">{item.tag || "Streaming VPN"}</p>
                <p class="compare-card-text">
                  {item.summary || item.description}
                </p>
                <div class="compare-rating">★ {item.rating}/5</div>

                <div class="compare-card-actions">
                  <a href={`/${item.category}/${item.slug}`} class="btn btn-secondary">
                    Read {item.name} Review →
                  </a>
                  <a
                    href={item.affiliate}
                    class="btn btn-primary"
                    target="_blank"
                    rel="nofollow sponsored noopener"
                  >
                    Check Price →
                  </a>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="compare-section">
          <h2>Best VPN by Use Case</h2>
          <ul class="compare-list">
            <li><strong>Best overall:</strong> NordVPN — fast and reliable</li>
            <li><strong>Best for beginners:</strong> CyberGhost — simple apps</li>
            <li><strong>Best value:</strong> affordable plans with good performance</li>
          </ul>
          <p>
            VPN performance depends on your location. Testing different servers helps
            achieve the best streaming experience.
          </p>
        </section>

        <section class="compare-section">
          <h2>Final Verdict</h2>
          <p>
            NordVPN is one of the best choices for Netflix thanks to speed and reliability.
            CyberGhost is also a strong option for beginners.
          </p>

          <div class="compare-bottom-cta">
            <a
              href="/go/nordvpn"
              class="btn btn-primary"
              target="_blank"
              rel="nofollow sponsored noopener"
            >
              Try NordVPN →
            </a>
          </div>
        </section>

        <section class="compare-section compare-faq-section">
          <h2>VPN FAQ</h2>
          <div class="compare-faq-list">
            {faqItems.map((item) => (
              <details class="compare-faq-item">
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </section>

      </article>

      <aside class="compare-sidebar">
        <div class="compare-sidebar-box">
          <h3>Quick Summary</h3>
          <ul>
            <li>Best VPNs for Netflix</li>
            <li>Access global content</li>
            <li>Fast and stable streaming</li>
          </ul>
        </div>

        <div class="compare-sidebar-box">
          <h3>Read Next</h3>
          {currentGuides.length > 0 && (
            <ul class="compare-sidebar-links">
              {currentGuides.map((item) => (
                <li>
                  <a href={`/${currentCategory}/${item.slug}`}>
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class="compare-sidebar-box">
          <h3>Best Choice</h3>
          <p>
            For streaming Netflix, choose a fast and reliable VPN.
          </p>
          <a
            href="/go/nordvpn"
            class="btn btn-primary compare-sidebar-btn"
            target="_blank"
            rel="nofollow sponsored noopener"
          >
            Get NordVPN →
          </a>
        </div>
      </aside>
    </div>
  </section>
</Layout>
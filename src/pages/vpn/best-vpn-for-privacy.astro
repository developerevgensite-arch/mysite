---
import Layout from "../../layouts/Layout.astro";
import "../../styles/compare-pages.css";
import reviews from "../../data/reviews.json";
import { guides } from "../../data/guides.js";

const pathname = Astro.url.pathname.split("/").filter(Boolean);

const currentCategory = pathname[0] || ""; // vpn
const currentSlug = pathname[1] || "";     // best-vpn-for-privacy

const currentGuides = (guides[currentCategory] ?? [])
  .filter((item) => item.slug !== currentSlug)
  .slice(0, 4);

const vpnReviews = reviews
  .filter((item) => item.category === currentCategory)
  .sort((a, b) => (b.rating || 0) - (a.rating || 0));

const topItems = vpnReviews.slice(0, 2);

const faqItems = [
  {
    q: "What is the best VPN for privacy?",
    a: "The best VPN for privacy is one with a strict no-logs policy, strong encryption, and secure servers."
  },
  {
    q: "Does a VPN really protect my privacy?",
    a: "A VPN hides your IP address and encrypts your internet traffic, making tracking much harder."
  },
  {
    q: "What features matter most for privacy?",
    a: "No-logs policy, encryption, kill switch, and DNS leak protection are essential."
  },
  {
    q: "Is a free VPN safe for privacy?",
    a: "Most free VPNs are not recommended because they may log data or show ads."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout
  title="Best VPN for Privacy in 2026"
  description="Compare the best VPNs for privacy and security. Find providers with strong encryption and no-logs policies."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

  <section class="compare-hero">
    <div class="page-container">
      <p class="compare-eyebrow">VPN Guide</p>
      <h1>Best VPN for Privacy in 2026</h1>
      <p class="compare-intro">
        Looking for the best VPN for privacy? We reviewed trusted providers to help you
        protect your data, hide your IP address, and stay anonymous online.
      </p>

      <div class="compare-cta-row">
        <a href="#top-picks" class="btn btn-primary">See Top Picks</a>
        {topItems[0] && (
          <a href={`/${topItems[0].category}/${topItems[0].slug}`} class="btn btn-secondary">
            Read {topItems[0].name} Review →
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="compare-content">
    <div class="page-container compare-layout">
      <article class="compare-main">

        <section class="compare-section">
          <h2>How to Choose a VPN for Privacy</h2>
          <p>
            Privacy-focused VPNs should have a strict no-logs policy and strong encryption.
          </p>
          <p>
            Look for features like kill switch, DNS leak protection, and secure jurisdictions.
          </p>
          <p>
            A trustworthy provider should also have a proven reputation and independent audits.
          </p>
        </section>

        <section class="compare-section" id="top-picks">
          <h2>Our Top {currentCategory.replace("-", " ")} Picks</h2>
          <p class="compare-note">
            These VPNs offer strong privacy and security features.
          </p>

          <div class="compare-cards-grid">
            {topItems.map((item, index) => (
              <div class="compare-card">
                {index === 0 && <span class="compare-badge">Top Pick</span>}
                <h3>{item.name}</h3>
                <p class="compare-card-tag">{item.tag || "Secure VPN"}</p>
                <p class="compare-card-text">
                  {item.summary || item.description}
                </p>
                <div class="compare-rating">★ {item.rating}/5</div>

                <div class="compare-card-actions">
                  <a href={`/${item.category}/${item.slug}`} class="btn btn-secondary">
                    Read {item.name} Review →
                  </a>
                  <a
                    href={item.affiliate}
                    class="btn btn-primary"
                    target="_blank"
                    rel="nofollow sponsored noopener"
                  >
                    Check Price →
                  </a>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="compare-section">
          <h2>Best VPN by Privacy Features</h2>
          <ul class="compare-list">
            <li><strong>Best overall:</strong> NordVPN — strong security and no-logs policy</li>
            <li><strong>Best for anonymity:</strong> advanced protection tools</li>
            <li><strong>Best for beginners:</strong> CyberGhost — easy setup</li>
          </ul>
          <p>
            Privacy users should prioritize security over price when choosing a VPN.
          </p>
        </section>

        <section class="compare-section">
          <h2>Final Verdict</h2>
          <p>
            A trusted VPN with strong privacy features is essential for protecting your data.
            NordVPN remains one of the best choices.
          </p>

          <div class="compare-bottom-cta">
            <a
              href="/go/nordvpn"
              class="btn btn-primary"
              target="_blank"
              rel="nofollow sponsored noopener"
            >
              Stay Private →
            </a>
          </div>
        </section>

        <section class="compare-section compare-faq-section">
          <h2>VPN FAQ</h2>
          <div class="compare-faq-list">
            {faqItems.map((item) => (
              <details class="compare-faq-item">
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </section>

      </article>

      <aside class="compare-sidebar">
        <div class="compare-sidebar-box">
          <h3>Quick Summary</h3>
          <ul>
            <li>Focus on privacy</li>
            <li>No-logs policy is key</li>
            <li>Use secure VPN providers</li>
          </ul>
        </div>

        <div class="compare-sidebar-box">
          <h3>Read Next</h3>
          {currentGuides.length > 0 && (
            <ul class="compare-sidebar-links">
              {currentGuides.map((item) => (
                <li>
                  <a href={`/${currentCategory}/${item.slug}`}>
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class="compare-sidebar-box">
          <h3>Best Choice</h3>
          <p>
            Protect your data with a trusted VPN.
          </p>
          <a
            href="/go/nordvpn"
            class="btn btn-primary compare-sidebar-btn"
            target="_blank"
            rel="nofollow sponsored noopener"
          >
            Get VPN →
          </a>
        </div>
      </aside>

    </div>
  </section>
</Layout>
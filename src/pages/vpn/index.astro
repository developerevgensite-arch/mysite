---
// Category page (vpn)

import Layout from "../../layouts/Layout.astro";
import reviews from "../../data/reviews.json";

const vpnReviews = reviews
  .filter((review) => review.category === "vpn")
  .sort((a, b) => b.rating - a.rating);

const faqItems = [
  {
    q: "Do I really need a VPN?",
    a: "A VPN is useful on public Wi‑Fi, when traveling, and for extra privacy from your ISP. It also helps access geo‑restricted websites and streaming libraries, depending on the provider."
  },
  {
    q: "Will a VPN slow down my internet?",
    a: "Usually a little. Speed depends on the VPN protocol, server distance, and your base connection. Top providers can be very fast on nearby servers and modern protocols like WireGuard."
  },
  {
    q: "Is a “no‑logs policy” important?",
    a: "Yes. A no‑logs policy means the provider claims it doesn’t store identifiable activity logs. For higher trust, look for independent audits, transparency reports, and a clear privacy policy."
  },
  {
    q: "What is the difference between VPN protocols (WireGuard, OpenVPN, IKEv2)?",
    a: "WireGuard is typically the fastest and simplest modern choice. OpenVPN is widely supported and very configurable. IKEv2 is great for mobile devices and quick reconnects when switching networks."
  },
  {
    q: "Can I use a VPN for streaming?",
    a: "Many VPNs work with streaming, but results change over time. Choose providers with a large server network, strong speeds, and a track record of reliable access to streaming platforms."
  },
  {
    q: "How many devices can I protect with one VPN subscription?",
    a: "It depends. Some services allow 5–10 devices, while others offer unlimited connections. If you have many devices at home, unlimited or router support can be a big advantage."
  }
];

// ссылки внизу страницы
const guides = [
  { slug: "best-vpn", title: "Best VPN" },
  { slug: "best-vpn-for-streaming", title: "Best VPN for Streaming" },
  { slug: "best-vpn-for-privacy", title: "Best VPN for Privacy" },
  { slug: "best-vpn-for-netflix", title: "Best Vpn for Netflix" }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a
    }
  }))
};
---

<Layout title="Best VPN Services">

<section class="category-hero">

<h1>Best VPN Services</h1>

<p class="category-subtitle">
  Looking for a reliable VPN? We tested popular services like NordVPN and CyberGhost to help you choose the right option for privacy, streaming and everyday use.
</p>

</section>

<section class="tools-grid">

  {vpnReviews.map((item) => (
    <article class={`tool-card ${item.badge ? 'featured' : ''}`}>
  
      {item.badge && <div class="card-badge">{item.badge}</div>}
  
      <h2>{item.name}</h2>
  
      {item.tag && <p class="card-tag">{item.tag}</p>}
  
      <p>{item.description}</p>
    <div class="tool-meta">
      <span class="rating">⭐ {item.rating} / 5 (Our score)</span>
    </div>
    <div class="buttons">

    <a href={`/vpn/${item.slug}`} class="btn btn-secondary">
      Read Review →
    </a>

    <a href={item.affiliate} class="btn btn-primary" target="_blank" rel="nofollow sponsored noopener">
      Check Price →
    </a>

    </div>

  </article>
))}

</section>

<section class="container-text">

  <h2>How to Choose the Best VPN</h2>
  
  <p>
  Choosing a VPN depends on what you need: privacy, streaming, or speed.
  Some VPNs are better for beginners, while others focus on performance and advanced features.
  </p>
  
  <p>
  We tested the most popular VPN services and selected the best options based on
  security, speed, ease of use and overall reliability.
  </p>
  
</section>

  <section class="container-text">

    <h2>Best VPN by Use Case</h2>
    
    <ul class="use-cases">
      <li><strong>Best for privacy:</strong> NordVPN — strong encryption and security</li>
      <li><strong>Best for streaming:</strong> CyberGhost — optimized streaming servers</li>
      <li><strong>Best overall value:</strong> easy setup and user-friendly apps</li>
    </ul>
    
  </section>


<section class="faq" aria-label="VPN FAQ">
  <div class="faq-inner">
    <h2>VPN FAQ</h2>
    <p class="faq-subtitle">
      Quick answers to common questions about VPN services.
    </p>

    <div class="faq-list">
      {faqItems.map((item) => (
        <details class="faq-item">
          <summary class="faq-question">
            <span>{item.q}</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-answer">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="guides-section-box">

  <div class="faq-inner">

    <h2>VPN Guides</h2>

    <div class="guides-grid">
      {guides.map((item) => (
        <a href={`/vpn/${item.slug}`} class="guide-card">
          <h3>{item.title}</h3>
          <span>Read Guide →</span>
        </a>
      ))}
    </div>
  </div>
</section>


<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

<style>

.category-hero{
max-width:900px;
margin:auto;
padding:20px 20px 10px;
text-align:left;
}

.category-subtitle{
font-size:18px;
color:#555;
margin-top:10px;
}

.card-badge{
  position:absolute;
  top:12px;
  right:12px;

  background:#22c55e;
  color:#fff;

  font-size:12px;
  font-weight:600;

  padding:5px 9px;
  border-radius:6px;

  line-height:1;
}

.card-tag{
  font-size:14px;
  color:#ff8a00;
  font-weight:600;
  margin:6px 0 8px;
}

.tools-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
gap:20px;
margin:20px auto 40px;
max-width:1000px;
padding:0 20px;
}

.tool-card{
  position: relative;
  background:#fff;
  border-radius:12px;
  padding:20px;
  box-shadow:0 5px 20px rgba(0,0,0,0.04);

  display:flex;
  flex-direction:column;

  gap:10px;
}

.tool-meta{
font-size:14px;
color:#444;
}

.rating{
font-weight:bold;
color:#2e7d32;
}

.btn{
margin-top:auto;
align-self:flex-start;
}

.container-text{
  max-width:900px;
  margin:0 auto 30px;
  padding:0 20px;
}

.use-cases{
  margin-top:10px;
  line-height:1.8;
  color:#444;
}

.buttons{
  margin-top:auto;
  display:flex;
  flex-direction:column;
  gap:10px;
}



.faq{
max-width:1000px;
margin:0 auto 40px;
padding:0 20px;
}

.faq-inner{
background:white;
border-radius:12px;
box-shadow:0 5px 20px rgba(0,0,0,0.04);
padding:22px;
}

.faq-inner h2{
margin-top:0;
margin-bottom:10px;
}

.faq-subtitle{
margin:0 0 18px;
font-size:16px;
color:#555;
max-width:760px;
}

.faq-list{
display:flex;
flex-direction:column;
gap:10px;
}

.faq-item{
border:1px solid #eceff3;
border-radius:10px;
background:#fff;
overflow:hidden;
}

.faq-question{
list-style:none;
display:flex;
align-items:center;
justify-content:space-between;
gap:16px;
padding:14px 16px;
cursor:pointer;
font-weight:700;
color:#111827;
}

.faq-question::-webkit-details-marker{
display:none;
}

.faq-icon{
width:28px;
height:28px;
border-radius:8px;
display:grid;
place-items:center;
background:#fff2e5;
color:#b45309;
font-weight:800;
flex:0 0 auto;
transition:transform .15s ease;
}

.faq-item[open] .faq-icon{
transform:rotate(45deg);
}

.faq-answer{
padding:0 16px 16px;
color:#4b5563;
}

.faq-answer p{
margin:0;
}

/* ссылки внизу страниц категори /hosting и аналогичных */
.guides-section-box{
  max-width:1000px;
  margin:80px auto 0px;
  padding:20px 20px;
  /* background:#fff; */
  border-radius:12px;
  /* box-shadow:0 5px 10px rgba(0,0,0,0.04); */
}

.guides-section-box h2{
  margin-top:0;
}

.guides-section{
  max-width:1000px;
  margin:40px auto;
  padding:0 20px;
}

.guides-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:16px;
  margin-top:20px;
}

.guide-card{
  background:#f9fafb;
  padding:18px;
  border-radius:10px;
  text-decoration:none;
  color:#111;
  border:1px solid #eef1f5;
  transition:0.2s;
}

.guide-card:hover{
  background:#fff;
  transform:translateY(-3px);
  box-shadow:0 8px 20px rgba(0,0,0,0.06);
}

.guide-card h3{
  margin:0 0 8px;
  font-size:16px;
}

.guide-card span{
  color:#ff8a00;
  font-weight:600;
  font-size:14px;
}

</style>

</Layout>

---
import Layout from "../../layouts/Layout.astro";
import "../../styles/compare-pages.css";
import reviews from "../../data/reviews.json";
import { guides } from "../../data/guides.js";

const pathname = Astro.url.pathname.split("/").filter(Boolean);

const currentCategory = pathname[0] || ""; // vpn
const currentSlug = pathname[1] || "";     // best-vpn

const currentGuides = (guides[currentCategory] ?? [])
  .filter((item) => item.slug !== currentSlug)
  .slice(0, 4);

const categoryReviews = reviews
  .filter((item) => item.category === currentCategory)
  .sort((a, b) => (b.rating || 0) - (a.rating || 0));

const topItems = categoryReviews.slice(0, 3);

const faqItems = [
  {
    q: "What is the best VPN for beginners?",
    a: "A beginner-friendly VPN should be easy to use, reliable, and fast. Providers like NordVPN and CyberGhost are popular choices."
  },
  {
    q: "Is a VPN necessary in 2026?",
    a: "A VPN is useful for privacy, security on public Wi-Fi, and accessing content from different regions."
  },
  {
    q: "Will a VPN slow down my internet?",
    a: "A VPN may slightly reduce speed, but high-quality providers minimize this impact."
  },
  {
    q: "How do I choose the best VPN?",
    a: "Focus on speed, privacy policy, ease of use, and server locations."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout
  title="Best VPN in 2026"
  description="Compare the best VPN services for privacy, streaming, and security."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

  <section class="compare-hero">
    <div class="page-container">
      <p class="compare-eyebrow">VPN Guide</p>
      <h1>Best VPN in 2026</h1>
      <p class="compare-intro">
        Looking for the best VPN? We reviewed top providers to help you choose
        the right option for privacy, streaming, and security.
      </p>

      <div class="compare-cta-row">
        <a href="#top-picks" class="btn btn-primary">See Top Picks</a>
        {topItems[0] && (
          <a href={`/${topItems[0].category}/${topItems[0].slug}`} class="btn btn-secondary">
            Read {topItems[0].name} Review →
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="compare-content">
    <div class="page-container compare-layout">
      <article class="compare-main">

        <section class="compare-section">
          <h2>How to Choose the Best VPN</h2>
          <p>
            The best VPN depends on your needs — privacy, streaming, or security.
          </p>
          <p>
            Key factors include speed, server locations, ease of use, and pricing.
          </p>
          <p>
            Most users should choose a simple and reliable VPN and upgrade later if needed.
          </p>
        </section>

        <section class="compare-section" id="top-picks">
          <h2>Our Top {currentCategory.replace("-", " ")} Picks</h2>
          <p class="compare-note">
            These are the main VPN providers currently featured on the site.
          </p>

          <div class="compare-cards-grid">
            {topItems.map((item, index) => (
              <div class="compare-card">
                {index === 0 && <span class="compare-badge">Top Pick</span>}
                <h3>{item.name}</h3>
                <p class="compare-card-tag">{item.tag || "VPN service"}</p>
                <p class="compare-card-text">
                  {item.summary || item.description}
                </p>
                <div class="compare-rating">★ {item.rating}/5</div>

                <div class="compare-card-actions">
                  <a href={`/${item.category}/${item.slug}`} class="btn btn-secondary">
                    Read {item.name} Review →
                  </a>
                  <a
                    href={item.affiliate}
                    class="btn btn-primary"
                    target="_blank"
                    rel="nofollow sponsored noopener"
                  >
                    Check Price →
                  </a>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="compare-section">
          <h2>Best VPN by Use Case</h2>
          <ul class="compare-list">
            <li><strong>Best overall:</strong> NordVPN — speed and security</li>
            <li><strong>Best for beginners:</strong> CyberGhost — easy to use</li>
            <li><strong>Best for privacy:</strong> strong encryption and no-logs</li>
          </ul>
          <p>
            Different VPNs focus on different strengths, so choosing the right one depends on your needs.
          </p>
        </section>

        <section class="compare-section">
          <h2>Final Verdict</h2>
          <p>
            NordVPN is one of the strongest all-around VPNs today.
          </p>

          <div class="compare-bottom-cta">
            <a
              href="/go/nordvpn"
              class="btn btn-primary"
              target="_blank"
              rel="nofollow sponsored noopener"
            >
              Visit VPN →
            </a>
          </div>
        </section>

        <section class="compare-section compare-faq-section">
          <h2>VPN FAQ</h2>
          <div class="compare-faq-list">
            {faqItems.map((item) => (
              <details class="compare-faq-item">
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </section>

      </article>

      <aside class="compare-sidebar">
        <div class="compare-sidebar-box">
          <h3>Quick Summary</h3>
          <ul>
            <li>Top VPN providers</li>
            <li>Privacy and streaming</li>
            <li>Easy to compare</li>
          </ul>
        </div>

        <div class="compare-sidebar-box">
          <h3>Read Next</h3>
          {currentGuides.length > 0 && (
            <ul class="compare-sidebar-links">
              {currentGuides.map((item) => (
                <li>
                  <a href={`/${currentCategory}/${item.slug}`}>
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class="compare-sidebar-box">
          <h3>Best Starting Point</h3>
          <p>
            Start with a reliable VPN and upgrade later if needed.
          </p>
          <a
            href="/go/nordvpn"
            class="btn btn-primary compare-sidebar-btn"
            target="_blank"
            rel="nofollow sponsored noopener"
          >
            Get VPN →
          </a>
        </div>
      </aside>

    </div>
  </section>
</Layout>
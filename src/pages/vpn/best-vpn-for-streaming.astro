---
import Layout from "../../layouts/Layout.astro";
import "../../styles/compare-pages.css";
import reviews from "../../data/reviews.json";
import { guides } from "../../data/guides.js";

const pathname = Astro.url.pathname.split("/").filter(Boolean);

const currentCategory = pathname[0] || ""; // vpn
const currentSlug = pathname[1] || "";     // best-vpn-for-streaming

const currentGuides = (guides[currentCategory] ?? [])
  .filter((item) => item.slug !== currentSlug)
  .slice(0, 4);

const vpnReviews = reviews
  .filter((item) => item.category === currentCategory)
  .sort((a, b) => (b.rating || 0) - (a.rating || 0));

const topItems = vpnReviews.slice(0, 3);

const faqItems = [
  {
    q: "What is the best VPN for streaming?",
    a: "A good streaming VPN should offer fast speeds, stable connections, and access to multiple regions."
  },
  {
    q: "Can a VPN unblock Netflix?",
    a: "Yes, many VPNs allow access to different regions, but performance depends on the provider."
  },
  {
    q: "Will a VPN reduce streaming quality?",
    a: "Premium VPNs usually support HD and 4K streaming with minimal speed loss."
  },
  {
    q: "What features matter for streaming?",
    a: "Speed, server locations, and stable connections are the most important factors."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout
  title="Best VPN for Streaming in 2026"
  description="Compare the best VPNs for streaming Netflix and more. Fast, stable, and reliable VPN providers."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

  <section class="compare-hero">
    <div class="page-container">
      <p class="compare-eyebrow">VPN Guide</p>
      <h1>Best VPN for Streaming in 2026</h1>
      <p class="compare-intro">
        Looking for a VPN for streaming? We tested top providers to help you watch
        content from different regions without buffering.
      </p>

      <div class="compare-cta-row">
        <a href="#top-picks" class="btn btn-primary">See Top Picks</a>
        {topItems[0] && (
          <a href={`/${topItems[0].category}/${topItems[0].slug}`} class="btn btn-secondary">
            Read {topItems[0].name} Review →
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="compare-content">
    <div class="page-container compare-layout">
      <article class="compare-main">

        <section class="compare-section">
          <h2>How to Choose a VPN for Streaming</h2>
          <p>
            Streaming VPNs need fast speeds and stable connections.
          </p>
          <p>
            Choose providers with servers in multiple countries and unlimited bandwidth.
          </p>
          <p>
            A reliable VPN helps avoid buffering and unlock global content.
          </p>
        </section>

        <section class="compare-section" id="top-picks">
          <h2>Our Top {currentCategory.replace("-", " ")} Picks</h2>
          <p class="compare-note">
            These VPNs are best for streaming performance.
          </p>

          <div class="compare-cards-grid">
            {topItems.map((item, index) => (
              <div class="compare-card">
                {index === 0 && <span class="compare-badge">Top Pick</span>}
                <h3>{item.name}</h3>
                <p class="compare-card-tag">{item.tag || "Streaming VPN"}</p>
                <p class="compare-card-text">
                  {item.summary || item.description}
                </p>
                <div class="compare-rating">★ {item.rating}/5</div>

                <div class="compare-card-actions">
                  <a href={`/${item.category}/${item.slug}`} class="btn btn-secondary">
                    Read {item.name} Review →
                  </a>
                  <a
                    href={item.affiliate}
                    class="btn btn-primary"
                    target="_blank"
                    rel="nofollow sponsored noopener"
                  >
                    Check Price →
                  </a>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="compare-section">
          <h2>Best VPN by Use Case</h2>
          <ul class="compare-list">
            <li><strong>Best overall:</strong> NordVPN — fast and stable</li>
            <li><strong>Best for 4K:</strong> high-speed servers</li>
            <li><strong>Best for beginners:</strong> easy-to-use apps</li>
          </ul>
          <p>
            A good VPN ensures smooth streaming without interruptions.
          </p>
        </section>

        <section class="compare-section">
          <h2>Final Verdict</h2>
          <p>
            NordVPN is one of the best choices for streaming due to speed and reliability.
          </p>

          <div class="compare-bottom-cta">
            <a
              href="/go/nordvpn"
              class="btn btn-primary"
              target="_blank"
              rel="nofollow sponsored noopener"
            >
              Start Streaming →
            </a>
          </div>
        </section>

        <section class="compare-section compare-faq-section">
          <h2>VPN FAQ</h2>
          <div class="compare-faq-list">
            {faqItems.map((item) => (
              <details class="compare-faq-item">
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </section>

      </article>

      <aside class="compare-sidebar">
        <div class="compare-sidebar-box">
          <h3>Quick Summary</h3>
          <ul>
            <li>Fast streaming VPNs</li>
            <li>Access global content</li>
            <li>Stable connections</li>
          </ul>
        </div>

        <div class="compare-sidebar-box">
          <h3>Read Next</h3>
          {currentGuides.length > 0 && (
            <ul class="compare-sidebar-links">
              {currentGuides.map((item) => (
                <li>
                  <a href={`/${currentCategory}/${item.slug}`}>
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class="compare-sidebar-box">
          <h3>Best for Streaming</h3>
          <p>
            Enjoy smooth streaming with a reliable VPN.
          </p>
          <a
            href="/go/nordvpn"
            class="btn btn-primary compare-sidebar-btn"
            target="_blank"
            rel="nofollow sponsored noopener"
          >
            Get VPN →
          </a>
        </div>
      </aside>

    </div>
  </section>
</Layout>
---
const CTA_URL = "/go/secure-offer";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>Protect Your Online Connection with NordVPN</title>

    <meta
      name="description"
      content="Learn how NordVPN can help protect your connection, improve privacy, and secure your activity on public Wi-Fi."
    />

    <meta
      name="robots"
      content="noindex, nofollow, noarchive, nosnippet, noimageindex"
    />

    <meta
      name="googlebot"
      content="noindex, nofollow, noarchive, nosnippet, noimageindex"
    />

    <meta name="bingbot" content="noindex, nofollow" />

    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <meta name="theme-color" content="#081436" />

    <link
      rel="icon"
      type="image/png"
      href="/images/vpn/vpn-icon.png"
     />
    
  </head>

  <body>
    <main class="page">

      <!-- HERO -->
      <section class="hero">
        <div class="glow glow-one"></div>
        <div class="glow glow-two"></div>

        <div class="hero-content">
          <div class="brand">
            <svg
              class="nordvpn-logo"
              width="143"
              height="32"
              viewBox="0 0 143 32"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              role="img"
              aria-label="NordVPN"
            >
              <title>NordVPN</title>
          
              <g fill="none" fill-rule="evenodd">
                <path
                  fill="#ffffff"
                  d="M139.14 10.846c0-.457.181-.913.491-1.235.31-.322.75-.51 1.189-.51.44 0 .879.188 1.189.51.31.322.491.778.491 1.235 0 .241-.052.456-.129.67a1.613 1.613 0 01-.362.565 1.535 1.535 0 01-.543.375c-.206.08-.413.135-.646.135-.232 0-.439-.054-.646-.135a1.535 1.535 0 01-.543-.375 1.613 1.613 0 01-.362-.564 1.557 1.557 0 01-.129-.671zm.31 0c0 .188.026.376.104.537.077.16.155.322.284.456.129.134.284.242.439.322.155.08.336.107.517.107.362 0 .724-.16.957-.429.258-.269.387-.617.387-1.02 0-.376-.155-.752-.387-1.02a1.331 1.331 0 00-.957-.43 1.12 1.12 0 00-.517.108c-.155.08-.31.187-.439.322a1.212 1.212 0 00-.284.456 1.67 1.67 0 00-.104.59zm1.112.993h-.388V9.852h.75c.387 0 .697.215.697.618a.55.55 0 01-.103.349c-.078.107-.155.188-.284.215l.387.805h-.439l-.362-.725h-.284v.725h.026zm.336-1.61h-.336v.482h.336c.155 0 .31-.053.31-.241s-.155-.242-.31-.242z"
                />
          
                <path
                  fill="#ffffff"
                  d="M60.334 24.617l-6.875-10.71v10.71h-3.05V9.101h3.541l6.488 10.147V9.101h3.05v15.516h-3.154zm10.158-10.818c-3.102 0-5.583 2.389-5.583 5.557 0 3.194 2.456 5.503 5.557 5.503 3.102 0 5.583-2.39 5.583-5.584-.026-3.14-2.507-5.476-5.557-5.476zm-.026 8.215c-1.396 0-2.533-1.101-2.533-2.712 0-1.61 1.112-2.684 2.507-2.684 1.396 0 2.533 1.1 2.533 2.684s-1.111 2.712-2.507 2.712zm13.259-8v3.033a5.748 5.748 0 00-.956-.08c-1.421 0-2.43 1.02-2.43 3.006v4.645h-2.92V14.04h2.817v1.557h.026c.543-1.208 1.577-1.664 2.636-1.664.31-.027.569.027.828.08zm8.53-4.94v6.148h-.026c-1.06-1.29-2.456-1.396-3.05-1.396-2.92 0-4.885 2.791-4.885 5.476 0 2.846 1.887 5.503 4.86 5.503.697 0 2.222-.107 3.178-1.557h.026v1.343h2.895V9.074h-2.998zm-2.43 12.94c-1.396 0-2.533-1.101-2.533-2.712 0-1.61 1.137-2.684 2.533-2.684s2.533 1.1 2.533 2.684c-.026 1.584-1.163 2.711-2.533 2.711zm11.734 2.603L96.157 9.101h3.334l3.877 11.812L107.271 9.1h3.283l-5.428 15.516h-3.567zm15.818-15.543h-5.557v15.543h3.102v-5.476h2.352c3.127 0 5.453-1.638 5.453-5.074-.025-3.302-2.352-4.993-5.35-4.993zm-.258 7.06h-2.223v-4.027h2.197c1.292 0 2.507.51 2.507 2.014 0 1.476-1.266 2.013-2.481 2.013zm17.084 8.483l-6.875-10.71v10.71h-3.05V9.101h3.541l6.488 10.147V9.101h3.05v15.516h-3.154z"
                />
          
                <path
                  fill="#4687ff"
                  d="M4.196 32C1.792 28.564.5 24.403.5 20.161.5 9.021 9.184 0 19.885 0c10.7 0 19.385 9.02 19.385 20.161 0 4.242-1.293 8.403-3.697 11.839L26.27 16.268l-.905 1.584.905 4.403-6.384-11.382-3.955 6.953.93 4.429-3.36-5.96L4.197 32z"
                />
              </g>
            </svg>
          </div>

          <p class="eyebrow">
            YOUR ONLINE ACTIVITY MAY BE EXPOSED
          </p>

          <h1>
            Protect Your Online Connection with NordVPN
          </h1>

          <p class="hero-text">
            Websites, advertisers and internet providers may collect
            information about your browsing activity. NordVPN can help
            protect your connection and provide greater privacy online.
          </p>

          <div class="hero-actions">
            <a
              href={CTA_URL}
              class="primary-button"
              rel="nofollow sponsored"
            >
              <span class="button-icon" aria-hidden="true">→</span>
              Protect My Connection with NordVPN
            </a>

            <p class="button-note">
              Continue to the official NordVPN website and view available plans.
            </p>
          </div>

          <div class="trust-row">
            <div class="trust-item">
              <span>✓</span>
              <strong>Windows compatible</strong>
            </div>

            <div class="trust-item">
              <span>✓</span>
              <strong>Multiple devices</strong>
            </div>

            <div class="trust-item">
              <span>✓</span>
              <strong>Secure connection</strong>
            </div>
          </div>
        </div>

        <div class="hero-visual">
          <div class="visual-card">
            <div class="laptop">
              <div class="laptop-screen">
                <div class="screen-grid"></div>

                <div class="shield">
                  <div class="shield-lock">
                    <span class="lock-top"></span>
                    <span class="lock-body"></span>
                  </div>

                  <strong>NordVPN</strong>
                </div>

                <div class="location-point location-one"></div>
                <div class="location-point location-two"></div>

                <div class="connection-line"></div>
              </div>

              <div class="laptop-base"></div>
            </div>

            <div class="status-card">
              <div class="status-icon">✓</div>

              <div>
                <strong>NordVPN protection</strong>
                <span>Online privacy and security</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- BENEFITS -->
      <section class="benefits-section">
        <div class="section-heading">
          <p class="eyebrow">WHY USE NORDVPN?</p>

          <h2>
            Add an extra layer of privacy to your browsing
          </h2>

          <p>
            NordVPN creates an encrypted connection between your device
            and the NordVPN service, helping reduce exposure on unsecured
            networks.
          </p>
        </div>

        <div class="cards">
          <article class="card">
            <div class="card-icon">Wi-Fi</div>

            <h3>Public Wi-Fi protection</h3>

            <p>
              Add protection with NordVPN when using Wi-Fi in hotels,
              airports, cafés and other public places.
            </p>
          </article>

          <article class="card">
            <div class="card-icon">IP</div>

            <h3>Greater online privacy</h3>

            <p>
              NordVPN can replace your visible IP address with the IP
              address of a NordVPN server.
            </p>
          </article>

          <article class="card">
            <div class="card-icon">✓</div>

            <h3>Secure NordVPN servers</h3>

            <p>
              Connect through encrypted NordVPN servers using applications
              designed for computers and mobile devices.
            </p>
          </article>
        </div>
      </section>

      <!-- FINAL CTA -->
      <section class="final-cta">
        <div class="final-icon" aria-hidden="true">
          <span>✓</span>
        </div>

        <div class="final-content">
          <p class="eyebrow">
            TAKE CONTROL OF YOUR CONNECTION
          </p>

          <h2>
            View the available NordVPN protection plans
          </h2>

          <p>
            Continue to the official NordVPN website to review features,
            compatible devices and current subscription options.
          </p>
        </div>

        <a
          href={CTA_URL}
          class="primary-button final-button"
          rel="nofollow sponsored"
        >
          View NordVPN Plans
          <span class="button-icon" aria-hidden="true">→</span>
        </a>
      </section>

      <!-- DISCLOSURE -->
      <footer class="disclosure">
        <p>
          This page provides general information about NordVPN.
          Product features, prices and availability may change.
        </p>
      </footer>

    </main>
  </body>
</html>

<style>
  :root {
    --background: #050914;
    --background-soft: #0a1124;
    --card: #0d1730;
    --card-light: #111f3e;
    --blue: #2176ff;
    --blue-light: #48a0ff;
    --cyan: #42d9ff;
    --orange: #ff792f;
    --text: #ffffff;
    --muted: #aeb9cb;
    --border: rgba(255, 255, 255, 0.11);
    --success: #45df8a;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background:
      radial-gradient(
        circle at 80% 10%,
        rgba(33, 118, 255, 0.14),
        transparent 30%
      ),
      radial-gradient(
        circle at 15% 30%,
        rgba(66, 217, 255, 0.07),
        transparent 28%
      ),
      var(--background);
    color: var(--text);
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .page {
    width: 100%;
    overflow: hidden;
  }

  .hero {
    position: relative;
    width: min(1180px, calc(100% - 40px));
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(390px, 0.92fr);
    align-items: start;
    gap: 58px;
    margin: 0 auto;
    padding: 52px 0 64px;
  }

  .hero-content,
  .hero-visual {
    position: relative;
  z-index: 2;
    
  }
  

  .glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(40px);
  }

  .glow-one {
    width: 420px;
    height: 420px;
    right: -190px;
    top: 30px;
    background: rgba(33, 118, 255, 0.13);
  }

  .glow-two {
    width: 300px;
    height: 300px;
    left: -180px;
    bottom: 60px;
    background: rgba(66, 217, 255, 0.08);
  }



  .brand {
  position: relative;
  top: -10px;
  display: flex;
  align-items: center;
  margin-bottom: 44px;
}

.hero-visual {
  padding-top: 48px;
}

.nordvpn-logo {
  width: 175px;
}

  .eyebrow {
    margin: 0 0 13px;
    color: var(--cyan);
    font-size: 13px;
    line-height: 1.4;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 680px;
    margin: 0 0 22px;
    font-size: clamp(43px, 5.3vw, 70px);
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .hero-text {
    max-width: 680px;
    margin: 0 0 25px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.7;
  }

  .benefit-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 29px;
  }

  .benefit-row {
    display: flex;
    align-items: center;
    gap: 11px;
    color: #e3e9f2;
    font-size: 15px;
    line-height: 1.5;
  }

  .check {
    width: 25px;
    height: 25px;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(69, 223, 138, 0.12);
    color: var(--success);
    font-weight: 900;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .primary-button {
    min-height: 59px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 15px 27px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    background:
      linear-gradient(
        180deg,
        var(--blue-light),
        var(--blue)
      );
    color: #ffffff;
    box-shadow:
      0 16px 38px rgba(33, 118, 255, 0.3),
      inset 0 1px rgba(255, 255, 255, 0.28);
    font-size: 17px;
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      background 0.18s ease;
  }

  .primary-button:hover {
    background:
      linear-gradient(
        180deg,
        #69b4ff,
        #0c61e9
      );
    box-shadow:
      0 20px 46px rgba(33, 118, 255, 0.4),
      inset 0 1px rgba(255, 255, 255, 0.28);
    transform: translateY(-2px);
  }

  .primary-button:focus-visible {
    outline: 3px solid rgba(72, 160, 255, 0.55);
    outline-offset: 4px;
  }

  .button-icon {
    width: 29px;
    height: 29px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 2px solid rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    font-size: 18px;
    line-height: 1;
  }

  .button-note {
    margin: 12px 0 0;
    color: #8e9aaf;
    font-size: 12px;
    line-height: 1.55;
  }

  .trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 22px;
    margin-top: 10px;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 7px;
    color: #c9d2df;
    font-size: 13px;
  }

  .trust-item span {
    color: var(--success);
    font-weight: 900;
  }

  .trust-item strong {
    font-weight: 600;
  }

  .visual-card {
    position: relative;
    min-height: 490px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 32px;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.055),
        rgba(255, 255, 255, 0.012)
      ),
      radial-gradient(
        circle at 60% 35%,
        rgba(33, 118, 255, 0.22),
        transparent 45%
      );
    box-shadow:
      0 35px 80px rgba(0, 0, 0, 0.42),
      inset 0 1px rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .visual-card::before {
    content: "";
    position: absolute;
    width: 300px;
    height: 300px;
    right: -100px;
    bottom: -120px;
    border-radius: 50%;
    background: rgba(33, 118, 255, 0.17);
    filter: blur(40px);
  }

  .laptop {
    position: relative;
    z-index: 2;
    width: 78%;
  }

  .laptop-screen {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 8px solid #11192a;
    border-radius: 20px 20px 8px 8px;
    background:
      radial-gradient(
        circle at center,
        rgba(33, 118, 255, 0.32),
        transparent 35%
      ),
      linear-gradient(
        145deg,
        #07122c,
        #0b2765
      );
    box-shadow:
      0 28px 55px rgba(0, 0, 0, 0.45),
      0 0 55px rgba(33, 118, 255, 0.18);
  }

  .screen-grid {
    position: absolute;
    inset: 0;
    opacity: 0.22;
    background-image:
      linear-gradient(
        rgba(255, 255, 255, 0.08) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.08) 1px,
        transparent 1px
      );
    background-size: 26px 26px;
  }

  .shield {
    position: absolute;
    z-index: 3;
    top: 50%;
    left: 50%;
    width: 135px;
    height: 155px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 4px solid #ffffff;
    border-radius: 44px 44px 58px 58px;
    background:
      linear-gradient(
        180deg,
        rgba(72, 160, 255, 0.96),
        rgba(16, 83, 204, 0.96)
      );
    box-shadow:
      0 0 36px rgba(72, 160, 255, 0.5),
      inset 0 0 24px rgba(255, 255, 255, 0.16);
    transform: translate(-50%, -50%);
  }

  .shield strong {
    margin-top: 12px;
    font-size: 20px;
    letter-spacing: 0.01em;
  }

  .shield-lock {
    position: relative;
    width: 45px;
    height: 52px;
  }

  .lock-top {
    position: absolute;
    top: 0;
    left: 8px;
    width: 29px;
    height: 28px;
    border: 6px solid #ffffff;
    border-bottom: 0;
    border-radius: 18px 18px 0 0;
  }

  .lock-body {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 33px;
    border-radius: 7px;
    background: #ffffff;
  }

  .location-point {
    position: absolute;
    z-index: 3;
    width: 19px;
    height: 19px;
    border: 4px solid rgba(255, 255, 255, 0.8);
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 19px rgba(255, 121, 47, 0.8);
  }

  .location-one {
    top: 24%;
    left: 17%;
  }

  .location-two {
    right: 15%;
    bottom: 22%;
  }

  .connection-line {
    position: absolute;
    top: 30%;
    left: 20%;
    width: 63%;
    height: 44%;
    border: 3px solid rgba(66, 217, 255, 0.6);
    border-right-color: transparent;
    border-bottom-color: transparent;
    border-radius: 50%;
    transform: rotate(8deg);
  }

  .laptop-base {
    width: 110%;
    height: 20px;
    margin-left: -5%;
    border-radius: 0 0 50% 50%;
    background:
      linear-gradient(
        180deg,
        #2b3447,
        #111724
      );
    box-shadow: 0 14px 22px rgba(0, 0, 0, 0.4);
  }

  .status-card {
    position: absolute;
    z-index: 4;
    right: 22px;
    bottom: 22px;
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 250px;
    padding: 15px 17px;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 14px;
    background: rgba(5, 9, 20, 0.9);
    backdrop-filter: blur(12px);
    box-shadow: 0 18px 38px rgba(0, 0, 0, 0.4);
  }

  .status-icon {
    width: 42px;
    height: 42px;
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(69, 223, 138, 0.14);
    color: var(--success);
    font-size: 20px;
    font-weight: 900;
  }

  .status-card strong,
  .status-card span {
    display: block;
  }

  .status-card strong {
    margin-bottom: 4px;
    font-size: 14px;
  }

  .status-card span {
    color: var(--muted);
    font-size: 12px;
  }

  .benefits-section {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
    padding: 64px 0 72px;
  }

  .section-heading {
    max-width: 760px;
    margin: 0 auto 36px;
    text-align: center;
  }

  .section-heading h2,
  .final-content h2 {
    margin: 0 0 15px;
    font-size: clamp(31px, 4vw, 46px);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .section-heading > p:last-child,
  .final-content > p {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.7;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .card {
    min-height: 225px;
    padding: 27px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.05),
        rgba(255, 255, 255, 0.015)
      );
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.18);
  }

  .card-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
    border-radius: 15px;
    background: rgba(33, 118, 255, 0.14);
    color: var(--blue-light);
    font-size: 17px;
    font-weight: 900;
  }

  .card h3 {
    margin: 0 0 10px;
    font-size: 20px;
  }

  .card p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .final-cta {
    width: min(1120px, calc(100% - 40px));
    display: grid;
    grid-template-columns: 86px minmax(0, 1fr) auto;
    align-items: center;
    gap: 26px;
    margin: 20px auto 0;
    padding: 34px;
    border: 1px solid rgba(33, 118, 255, 0.32);
    border-radius: 23px;
    background:
      linear-gradient(
        100deg,
        rgba(33, 118, 255, 0.15),
        rgba(33, 118, 255, 0.035)
      );
  }

  .final-icon {
    width: 70px;
    height: 78px;
    display: flex;
    align-items: center;

---
const CTA_URL = "/go/avast-bemob";
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>Pobierz Avast Free Antivirus dla systemu Windows</title>

    <meta
      name="description"
      content="Pobierz Avast Free Antivirus dla systemu Windows i pomóż chronić komputer przed złośliwym oprogramowaniem, niebezpiecznymi plikami oraz zagrożeniami online."
    />

    <!-- Запрещаем индексацию страницы -->
    <meta
      name="robots"
      content="noindex, nofollow, noarchive, nosnippet, noimageindex"
    />

    <meta
      name="googlebot"
      content="noindex, nofollow, noarchive, nosnippet, noimageindex"
    />

    <meta name="bingbot" content="noindex, nofollow" />

    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <meta name="theme-color" content="#ff7800" />

    <link rel="icon" href="/avast-icon.png" />
  </head>

  <body>
    <main class="page">

      <!-- HERO -->
      <section class="hero">
        <div class="hero-glow hero-glow-one"></div>
        <div class="hero-glow hero-glow-two"></div>

        <div class="hero-content">
          <div class="brand">
          
            <img
              src="/images/avast/avast-icon.png"
              alt=""
              class="brand-icon"
              width="54"
              height="54"
            />
            <span class="brand-name">Avast</span>
          </div>

          <p class="eyebrow">OCHRONA ANTYWIRUSOWA DLA SYSTEMU WINDOWS</p>

          <h1>
            Pobierz Avast Free Antivirus dla systemu Windows
          </h1>

          <p class="hero-text">
            Pomóż chronić komputer z systemem Windows przed złośliwym oprogramowaniem,
            niebezpiecznymi plikami i zagrożeniami online dzięki Avast Free Antivirus.
          </p>

          <div class="hero-actions">
            <a
              href={CTA_URL}
              class="primary-button"
              rel="nofollow sponsored"
            >
              <span class="download-icon" aria-hidden="true">↓</span>
              Pobierz Avast Free
            </a>

            <p class="download-note">
              Kliknięcie przycisku rozpocznie pobieranie instalatora Avast.
            </p>
          </div>

          <div class="trust-row" aria-label="Informacje o produkcie">
            <div class="trust-item">
              <span class="trust-icon">✓</span>
              <span>Dla komputerów z systemem Windows</span>
            </div>

            <div class="trust-item">
              <span class="trust-icon">✓</span>
              <span>Prosta instalacja</span>
            </div>

            <div class="trust-item">
              <span class="trust-icon">✓</span>
              <span>Ochrona antywirusowa</span>
            </div>
          </div>
        </div>

        <div class="hero-visual">
          <div class="visual-card">

            <!--
              После получения материалов от Марии положи изображение сюда:
              public/images/avast/avast-product.jpg
            -->
            <img
              src="/images/avast/avast-product.jpg"
              alt="Avast Free Antivirus dla systemu Windows"
              class="product-image"
              width="620"
              height="520"
            />

            <div class="protection-badge">
              <div class="shield">
                <span>✓</span>
              </div>

              <div>
                <strong>Ochrona komputera</strong>
                <span>Avast Free Antivirus</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- BENEFITS -->
      <section class="section benefits-section">
        <div class="section-heading">
          <p class="section-eyebrow">CODZIENNA OCHRONA</p>
          <h2>Pomóż chronić komputer z systemem Windows</h2>
          <p>
            Avast Free Antivirus oferuje podstawowe funkcje bezpieczeństwa,
            które pomagają chronić komputer podczas codziennego użytkowania.
          </p>
        </div>

        <div class="benefits-grid">
          <article class="benefit-card">
            <div class="benefit-icon">●</div>
            <h3>Ochrona antywirusowa w czasie rzeczywistym</h3>
            <p>
              Pomaga wykrywać i blokować złośliwe oprogramowanie oraz inne zagrożenia
              podczas korzystania z komputera.
            </p>
          </article>

          <article class="benefit-card">
            <div class="benefit-icon">↓</div>
            <h3>Bezpieczniejsze pobieranie</h3>
            <p>
              Zwiększa ochronę podczas pobierania plików i aplikacji
              z internetu.
            </p>
          </article>

          <article class="benefit-card">
            <div class="benefit-icon">⌁</div>
            <h3>Bezpieczniejsze przeglądanie internetu</h3>
            <p>
              Pomaga chronić komputer podczas odwiedzania stron internetowych.
            </p>
          </article>
        </div>
      </section>

      <!-- INSTALLATION -->
      <section class="section installation-section">
        <div class="installation-content">
          <p class="section-eyebrow">SZYBKA INSTALACJA</p>
          <h2>Jak zainstalować Avast</h2>

          <div class="steps">
            <div class="step">
              <div class="step-number">1</div>
              <div>
                <h3>Pobierz instalator</h3>
                <p>
                  Click the Pobierz Avast Free button to begin downloading
                  the Windows installer.
                </p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">2</div>
              <div>
                <h3>Otwórz pobrany plik</h3>
                <p>
                  Otwórz instalator Avast z listy pobranych plików w przeglądarce
                  lub z folderu „Pobrane”.
                </p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">3</div>
              <div>
                <h3>Postępuj zgodnie z instrukcjami instalacji</h3>
                <p>
                  Postępuj zgodnie z instrukcjami wyświetlanymi przez instalator Avast,
                  aby zakończyć instalację.
                </p>
              </div>
            </div>
          </div>
        </div>

        <aside class="installation-box">
          <div class="installation-shield">
            <span>✓</span>
          </div>

          <h3>Chcesz lepiej chronić swój komputer?</h3>

          <p>
            Pobierz Avast Free Antivirus and follow the installation
            instructions on your Windows computer.
          </p>

          <a
            href={CTA_URL}
            class="primary-button primary-button-full"
            rel="nofollow sponsored"
          >
            <span class="download-icon" aria-hidden="true">↓</span>
            Pobierz Avast Free
          </a>

          <p class="download-note centered">
            Po kliknięciu rozpocznie się pobieranie instalatora Avast.
          </p>
        </aside>
      </section>

      <!-- FINAL CTA -->
      <section class="final-section">
        <div class="final-shield" aria-hidden="true">
          <span>✓</span>
        </div>

        <div class="final-content">
          <p class="section-eyebrow">AVAST FREE ANTIVIRUS</p>

          <h2>Dodaj ochronę antywirusową do komputera z systemem Windows</h2>

          <p>
            Pobierz Avast Free Antivirus and follow the installation
            instructions to begin protecting your computer.
          </p>
        </div>

        <a
          href={CTA_URL}
          class="primary-button final-button"
          rel="nofollow sponsored"
        >
          <span class="download-icon" aria-hidden="true">↓</span>
          Pobierz za darmo
        </a>
      </section>

      <!-- DISCLOSURE -->
      <section class="disclosure">
        <p>
          Avast jest znakiem towarowym firmy Gen Digital Inc. Informacje o produkcie mogą ulec zmianie.
        </p>
      </section>

    </main>
  </body>
</html>

<style>
  :root {
    --avast-orange: #ff7800;
    --avast-orange-dark: #e85d00;
    --avast-orange-light: #ff9d3d;
    --background: #080b13;
    --background-soft: #101521;
    --card-background: #151b29;
    --border: rgba(255, 255, 255, 0.1);
    --text: #ffffff;
    --text-muted: #b6bfcc;
    --success: #62d84e;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background:
      radial-gradient(
        circle at 70% 10%,
        rgba(255, 120, 0, 0.12),
        transparent 32%
      ),
      var(--background);
    color: var(--text);
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  img {
    display: block;
    max-width: 100%;
  }

  .page {
    width: 100%;
    overflow: hidden;
  }

  .hero {
    position: relative;
    min-height: 700px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(420px, 0.9fr);
    align-items: center;
    gap: 56px;
    max-width: 1240px;
    margin: 0 auto;
    padding: 70px 32px 80px;
  }

  .hero-content,
  .hero-visual {
    position: relative;
    z-index: 2;
  }

  .hero-glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(20px);
  }

  .hero-glow-one {
    width: 420px;
    height: 420px;
    right: -180px;
    top: 30px;
    background: rgba(255, 120, 0, 0.13);
  }

  .hero-glow-two {
    width: 300px;
    height: 300px;
    left: -180px;
    bottom: 40px;
    background: rgba(255, 120, 0, 0.07);
  }

  .brand {
  min-height: 54px;
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 38px;
}

.brand-icon {
  width: 54px;
  height: 54px;
  object-fit: contain;
  flex: 0 0 auto;
}

.brand-name {
  color: #ffffff;
  font-size: 34px;
  line-height: 1;
  font-weight: 700;
  letter-spacing: -0.03em;
}

  .eyebrow,
  .section-eyebrow {
    margin: 0 0 14px;
    color: var(--avast-orange-light);
    font-size: 13px;
    line-height: 1.4;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 670px;
    margin: 0 0 22px;
    font-size: clamp(44px, 5.2vw, 72px);
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .hero-text {
    max-width: 650px;
    margin: 0 0 30px;
    color: var(--text-muted);
    font-size: 19px;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .primary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 60px;
    padding: 15px 27px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    background:
      linear-gradient(
        180deg,
        var(--avast-orange-light),
        var(--avast-orange)
      );
    color: #ffffff;
    box-shadow:
      0 14px 34px rgba(255, 120, 0, 0.28),
      inset 0 1px rgba(255, 255, 255, 0.25);
    font-size: 17px;
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      background 0.18s ease;
  }

  .primary-button:hover {
    background:
      linear-gradient(
        180deg,
        #ffac59,
        var(--avast-orange-dark)
      );
    box-shadow:
      0 18px 42px rgba(255, 120, 0, 0.36),
      inset 0 1px rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  .primary-button:focus-visible {
    outline: 3px solid rgba(255, 157, 61, 0.55);
    outline-offset: 4px;
  }

  .download-icon {
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 2px solid rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    font-size: 20px;
    line-height: 1;
  }

  .download-note {
    margin: 13px 0 0;
    color: #9ea8b7;
    font-size: 13px;
    line-height: 1.55;
  }

  .trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 24px;
    margin-top: 32px;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #d5dae2;
    font-size: 14px;
  }

  .trust-icon {
    display: inline-flex;
    width: 22px;
    height: 22px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(98, 216, 78, 0.12);
    color: var(--success);
    font-weight: 900;
  }

  .visual-card {
    position: relative;
    min-height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 34px;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.06),
        rgba(255, 255, 255, 0.01)
      ),
      radial-gradient(
        circle at 65% 35%,
        rgba(255, 120, 0, 0.16),
        transparent 45%
      );
    box-shadow:
      0 35px 80px rgba(0, 0, 0, 0.42),
      inset 0 1px rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .visual-card::before {
    content: "";
    position: absolute;
    width: 280px;
    height: 280px;
    right: -80px;
    bottom: -100px;
    border-radius: 50%;
    background: rgba(255, 120, 0, 0.16);
    filter: blur(40px);
  }

  .product-image {
    position: relative;
    z-index: 1;
    max-height: 440px;
    width: auto;
    object-fit: contain;
  }

  .protection-badge {
    position: absolute;
    z-index: 3;
    left: 24px;
    bottom: 24px;
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 235px;
    padding: 15px 17px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 15px;
    background: rgba(8, 11, 19, 0.9);
    backdrop-filter: blur(12px);
    box-shadow: 0 18px 38px rgba(0, 0, 0, 0.4);
  }

  .shield,
  .installation-shield,
  .final-shield {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 3px solid var(--avast-orange);
    background:
      radial-gradient(
        circle,
        rgba(255, 120, 0, 0.2),
        rgba(255, 120, 0, 0.03)
      );
    color: #ffffff;
    box-shadow:
      0 0 25px rgba(255, 120, 0, 0.25),
      inset 0 0 20px rgba(255, 120, 0, 0.12);
  }

  .shield {
    width: 48px;
    height: 54px;
    border-radius: 18px 18px 23px 23px;
    font-size: 22px;
  }

  .protection-badge strong,
  .protection-badge span {
    display: block;
  }

  .protection-badge strong {
    margin-bottom: 4px;
    font-size: 14px;
  }

  .protection-badge div > span {
    color: var(--text-muted);
    font-size: 12px;
  }

  .section {
    max-width: 1180px;
    margin: 0 auto 30px;
    padding: 70px 32px;
  }

  .section-heading {
    max-width: 720px;
    margin: 0 auto 38px;
    text-align: center;
  }

  .section h2,
  .final-section h2 {
    margin: 0 0 16px;
    font-size: clamp(31px, 4vw, 48px);
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .section-heading > p:last-child,
  .installation-content > p,
  .final-content > p {
    color: var(--text-muted);
    font-size: 17px;
    line-height: 1.7;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .benefit-card {
    min-height: 245px;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.055),
        rgba(255, 255, 255, 0.018)
      );
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.18);
  }

  .benefit-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    border-radius: 14px;
    background: rgba(255, 120, 0, 0.13);
    color: var(--avast-orange-light);
    font-size: 24px;
    font-weight: 900;
  }

  .benefit-card h3,
  .step h3,
  .installation-box h3 {
    margin: 0 0 10px;
    font-size: 20px;
  }

  .benefit-card p,
  .step p,
  .installation-box p {
    margin: 0;
    color: var(--text-muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .installation-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 390px;
    align-items: center;
    gap: 56px;
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 32px;
  }

  .step {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 18px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 17px;
    background: rgba(255, 255, 255, 0.025);
  }

  .step-number {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background:
      linear-gradient(
        180deg,
        var(--avast-orange-light),
        var(--avast-orange)
      );
    color: #ffffff;
    font-size: 20px;
    font-weight: 900;
  }

  .installation-box {
    padding: 34px;
    border: 1px solid rgba(255, 120, 0, 0.3);
    border-radius: 24px;
    background:
      radial-gradient(
        circle at top,
        rgba(255, 120, 0, 0.15),
        transparent 45%
      ),
      var(--card-background);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.35);
    text-align: center;
  }

  .installation-shield {
    width: 74px;
    height: 82px;
    margin: 0 auto 24px;
    border-radius: 27px 27px 34px 34px;
    font-size: 32px;
  }

  .installation-box h3 {
    font-size: 25px;
  }

  .installation-box p {
    margin-bottom: 24px;
  }

  .primary-button-full {
    width: 100%;
  }

  .centered {
    text-align: center;
  }

  .final-section {
    max-width: 1180px;
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr) auto;
    align-items: center;
    gap: 28px;
    margin: 30px auto;
    padding: 38px;
    border: 1px solid rgba(255, 120, 0, 0.3);
    border-radius: 25px;
    background:
      linear-gradient(
        100deg,
        rgba(255, 120, 0, 0.13),
        rgba(255, 120, 0, 0.03)
      );
  }

  .final-shield {
    width: 78px;
    height: 88px;
    border-radius: 28px 28px 36px 36px;
    font-size: 34px;
  }

  .final-content h2 {
    font-size: 34px;
  }

  .final-content > p {
    margin: 0;
    max-width: 650px;
  }

  .final-button {
    white-space: nowrap;
  }

  .disclosure {
    max-width: 980px;
    margin: 0 auto;
    padding: 22px 32px 50px;
    text-align: center;
  }

  .disclosure p {
    margin: 0;
    color: #7f8998;
    font-size: 12px;
    line-height: 1.7;
  }

  @media (max-width: 980px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 44px;
      padding-top: 45px;
    }

    .hero-content {
      text-align: center;
    }

    .brand,
    .hero-actions {
      align-items: center;
      justify-content: center;
    }

    .hero-text {
      margin-left: auto;
      margin-right: auto;
    }

    .trust-row {
      justify-content: center;
    }

    .visual-card {
      max-width: 620px;
      min-height: 460px;
      margin: 0 auto;
    }

    .installation-section {
      grid-template-columns: 1fr;
    }

    .installation-box {
      max-width: 520px;
      margin: 0 auto;
    }

    .final-section {
      grid-template-columns: 80px 1fr;
    }

    .final-button {
      grid-column: 1 / -1;
      width: 100%;
    }
  }

  @media (max-width: 760px) {
    .hero {
      padding: 35px 20px 55px;
    }

    h1 {
      font-size: 42px;
    }

    .brand {
      margin-bottom: 28px;
    }

    .benefits-grid {
      grid-template-columns: 1fr;
    }

    .section {
      padding: 52px 20px;
    }

    .benefit-card {
      min-height: auto;
    }

    .visual-card {
      min-height: 390px;
      border-radius: 24px;
    }

    .product-image {
      max-height: 330px;
    }

    .protection-badge {
      right: 18px;
      left: 18px;
      bottom: 18px;
      min-width: 0;
    }

    .final-section {
      grid-template-columns: 1fr;
      margin: 22px 20px;
      padding: 30px 22px;
      text-align: center;
    }

    .final-shield {
      margin: 0 auto;
    }

    .final-content h2 {
      font-size: 29px;
    }
  }

  @media (max-width: 480px) {
    h1 {
      font-size: 36px;
    }

    .hero-text {
      font-size: 16px;
    }

    .primary-button {
      width: 100%;
      padding-left: 18px;
      padding-right: 18px;
    }

    .trust-row {
      align-items: flex-start;
      flex-direction: column;
      max-width: 290px;
      margin-left: auto;
      margin-right: auto;
    }

    .visual-card {
      min-height: 340px;
    }

    .product-image {
      max-height: 275px;
    }

    .step {

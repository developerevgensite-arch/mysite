---
// Category page (security)

import Layout from "../../layouts/Layout.astro";
import reviews from "../../data/reviews.json";
import { guides as securityGuides } from "../../data/guides.js";

const guides = securityGuides.security ?? [];

const securityReviews = reviews
  .filter((review) => review.category === "security")
  .sort((a, b) => b.rating - a.rating);
  // faq
const faqItems = [
  {
    q: "What security tools are most important for everyday users?",
    a: "Start with a password manager, two‑factor authentication, and regular software updates. For extra protection, add anti‑malware, encrypted backups, and safe browsing habits."
  },
  {
    q: "Is a password manager worth it?",
    a: "Yes. It helps you generate and store strong unique passwords for every site, reduces reuse, and makes logins faster. Many options also include passkeys, secure sharing, and breach monitoring."
  },
  {
    q: "What is 2FA and which method is best?",
    a: "2FA adds a second step after your password. Authenticator apps and hardware keys are generally safer than SMS. For the best security, use passkeys or a hardware key where possible."
  },
  {
    q: "Do I still need antivirus on Windows?",
    a: "Built‑in protection is much better today, but antivirus can still add value with phishing protection, ransomware shields, and identity monitoring. Choose lightweight tools that don’t slow down your device."
  },
  {
    q: "How do I know if a security tool is trustworthy?",
    a: "Look for clear privacy policies, independent audits, good update history, and transparency about data collection. Avoid tools that are vague about logging or sell user data."
  },
  {
    q: "What’s the best way to recover after an account gets hacked?",
    a: "Change passwords (starting with email), revoke active sessions, enable 2FA, and check recovery options. A password manager and security checklist make this process much faster."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a
    }
  }))
};
---

<Layout title="Best Security Tools">

<section class="category-hero">

<h1>Best Security Tools</h1>

<p class="category-subtitle">
Protect your passwords, accounts and devices with modern security software.
</p>

</section>

<section class="tools-grid">

  {securityReviews.map((item) => (
    <article class="tool-card">
    {item.badge && <div class="card-badge">{item.badge}</div>}
    <h2>{item.name}</h2>
    {item.tag && <p class="card-tag">{item.tag}</p>}
    <p>{item.description}</p>
  
      <div class="tool-meta">
        <span class="rating">⭐ {item.rating} / 5 (Our score)</span>
      </div>
      
      <div class="buttons">
  
        <a href={`/security/${item.slug}`} class="btn btn-secondary">
          Read Review →
        </a>
  
        <a href={item.affiliate} class="btn btn-primary" target="_blank" rel="nofollow sponsored noopener">
          Check Tool →
        </a>
  
      </div>
  
    </article>
  ))}
  
  </section>

<section class="container-text">

  <h2>How to Stay Safe Online</h2>
  
  <p>
  Online security is not just for experts. Today, anyone can protect their accounts and personal data with a few simple tools.
  </p>
  
  <p>
  The most important things are strong passwords, two-factor authentication, and using trusted apps. Good security tools make this easy without slowing you down.
  </p>
  
</section>

<section class="container-text">

  <h2>Best Security Tools by Use Case</h2>
  
  <ul class="use-cases">
    <li><strong>Best for password security:</strong> password managers like 1Password</li>
    <li><strong>Best for full protection:</strong> all-in-one security tools</li>
    <li><strong>Best overall value:</strong> simple tools with easy setup</li>
  </ul>
  
</section>


<!-- faq -->
<section class="faq" aria-label="Security tools FAQ">
  <div class="faq-inner">
    <h2>Security FAQ</h2>
    <p class="faq-subtitle">
      Quick answers to common questions about security tools and best practices.
    </p>

    <div class="faq-list">
      {faqItems.map((item) => (
        <details class="faq-item">
          <summary class="faq-question">
            <span>{item.q}</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-answer">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="guides-section-box">

  <div class="faq-inner">

    <h2>Security Guides</h2>

    <div class="guides-grid">
      {guides.map((item) => (
        <a href={`/security/${item.slug}/`} class="guide-card">
          <h3>{item.title}</h3>
          <span>Read Guide →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

<style>

.category-hero{
max-width:900px;
margin:auto;
padding:20px 20px 10px;
text-align:left;
}

.category-subtitle{
font-size:18px;
color:#555;
margin-top:10px;
}

.card-tag{
  font-size:14px;
  color:#ff8a00;
  font-weight:600;
  margin:6px 0 8px;
}

.card-badge{
  position:absolute;
  top:16px;
  right:16px;

  background:#22c55e;
  color:#fff;

  font-size:12px;
  font-weight:600;

  padding:6px 10px;
  border-radius:6px;
}

.tools-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(260px,1fr));/* ← чуть шире */
  gap:20px;
  margin:20px auto 40px;
  max-width:1000px; /* ← ВАЖНО */
  padding:0 20px;
}

.tool-card{
position:relative;
background:#fff;
border-radius:12px;
padding:20px;
box-shadow:0 5px 20px rgba(0,0,0,0.04);
display:flex;
flex-direction:column;
gap:10px;
}

.tool-meta{
font-size:14px;
color:#444;
}

.rating{
font-weight:bold;
color:#2e7d32;
}

.btn{
margin-top:auto;
align-self:flex-start;
}


.container-text{
  max-width:900px;
  margin:0 auto 30px;
  padding:0 20px;
}

.use-cases{
  margin-top:10px;
  line-height:1.8;
  color:#444;
}

.buttons{
  margin-top:auto;
  display:flex;
  flex-direction:column;
  gap:10px;
}




/* faq */
.faq{
max-width:1000px;
margin:0 auto 40px;
padding:0 20px;
}

.faq-inner{
background:white;
border-radius:12px;
box-shadow:0 5px 20px rgba(0,0,0,0.04);
padding:22px;
}

.faq-inner h2{
margin-top:0;
margin-bottom:10px;
}

.faq-subtitle{
margin:0 0 18px;
font-size:16px;
color:#555;
max-width:760px;
}

.faq-list{
display:flex;
flex-direction:column;
gap:10px;
}

.faq-item{
border:1px solid #eceff3;
border-radius:10px;
background:#fff;
overflow:hidden;
}

.faq-question{
list-style:none;
display:flex;
align-items:center;
justify-content:space-between;
gap:16px;
padding:14px 16px;
cursor:pointer;
font-weight:700;
color:#111827;
}

.faq-question::-webkit-details-marker{
display:none;
}

.faq-icon{
width:28px;
height:28px;
border-radius:8px;
display:grid;
place-items:center;
background:#fff2e5;
color:#b45309;
font-weight:800;
flex:0 0 auto;
transition:transform .15s ease;
}

.faq-item[open] .faq-icon{
transform:rotate(45deg);
}

.faq-answer{
padding:0 16px 16px;
color:#4b5563;
}

.faq-answer p{
margin:0;
}

.guides-section-box{
  max-width:1000px;
  margin:80px auto 0px;
  padding:20px 20px;
  border-radius:12px;
}

.guides-section-box h2{
  margin-top:0;
}

.guides-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:16px;
  margin-top:20px;
}

.guide-card{
  background:#f9fafb;
  padding:18px;
  border-radius:10px;
  text-decoration:none;
  color:#111;
  border:1px solid #eef1f5;
  transition:0.2s;
  display:block;
}

.guide-card:hover{
  background:#fff;
  transform:translateY(-3px);
  box-shadow:0 8px 20px rgba(0,0,0,0.06);
}

.guide-card h3{
  margin:0 0 8px;
  font-size:16px;
}

.guide-card span{
  color:#ff8a00;
  font-weight:600;
  font-size:14px;
}

</style>

</Layout>

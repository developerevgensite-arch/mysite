---
import Layout from "../../layouts/Layout.astro";
import "../../styles/compare-pages.css"; 
import reviews from "../../data/reviews.json";
import { guides } from "../../data/guides.js";

const pathname = Astro.url.pathname.split("/").filter(Boolean);

const currentCategory = pathname[0] || "";
const currentSlug = pathname[1] || "";

const currentGuides = (guides[currentCategory] ?? [])
  .filter((item) => item.slug !== currentSlug)
  .slice(0, 4);

// 🔥 получаем конкретные сервисы
const hostinger = reviews.find((item) => item.slug === "hostinger");
const bluehost = reviews.find((item) => item.slug === "bluehost");

// 🔥 защита от null (очень важно)
const compareItems = [hostinger, bluehost].filter(Boolean);

const faqItems = [
  {
    q: "Which is better: Hostinger or Bluehost?",
    a: "Hostinger is often better for pricing and performance, while Bluehost is popular for beginners and WordPress integration."
  },
  {
    q: "Is Hostinger cheaper than Bluehost?",
    a: "Yes, Hostinger usually offers lower introductory prices compared to Bluehost."
  },
  {
    q: "Which hosting is better for WordPress?",
    a: "Both support WordPress. Bluehost is officially recommended, while Hostinger offers better value."
  },
  {
    q: "Can I switch hosting providers later?",
    a: "Yes, many hosting providers offer free migration services."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout
  title="Hostinger vs Bluehost (2026 Comparison)"
  description="Compare Hostinger vs Bluehost: pricing, performance, ease of use, and features."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

  <section class="compare-hero">
    <div class="page-container">
      <p class="compare-eyebrow">Hosting Comparison</p>
      <h1>Hostinger vs Bluehost</h1>
      <p class="compare-intro">
        Choosing between Hostinger and Bluehost? Both are popular hosting providers,
        but they offer different advantages. This comparison will help you decide
        which one is better for your website.
      </p>

      <div class="compare-cta-row">
        <a href="#comparison" class="btn btn-primary">See Comparison</a>
        {compareItems[0] && (
          <a href={`/${compareItems[0].category}/${compareItems[0].slug}`} class="btn btn-secondary">
            Read {compareItems[0].name} Review →
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="compare-content">
    <div class="page-container compare-layout">
      <article class="compare-main">

        <section class="compare-section" id="comparison">
          <h2>Quick Comparison</h2>

          <div class="compare-cards-grid">
            {compareItems.map((item) => (
              <div class="compare-card">
                <h3>{item.name}</h3>
                <p class="compare-card-tag">{item.tag || "Hosting provider"}</p>
                <p class="compare-card-text">
                  {item.summary || item.description}
                </p>
                <div class="compare-rating">★ {item.rating}/5</div>

                <div class="compare-card-actions">
                  <a href={`/${item.category}/${item.slug}`} class="btn btn-secondary">
                    Read {item.name} Review →
                  </a>
                  <a
                    href={item.affiliate}
                    class="btn btn-primary"
                    target="_blank"
                    rel="nofollow sponsored noopener"
                  >
                    Check Price →
                  </a>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="compare-section">
          <h2>Pricing</h2>
          <p>
            Hostinger is usually the cheaper option, especially for long-term plans.
            Bluehost tends to have higher renewal prices.
          </p>
        </section>

        <section class="compare-section">
          <h2>Performance</h2>
          <p>
            Hostinger generally offers better performance thanks to modern infrastructure.
            Bluehost is stable but may be slightly slower in some cases.
          </p>
        </section>

        <section class="compare-section">
          <h2>Ease of Use</h2>
          <p>
            Bluehost is very beginner-friendly, especially for WordPress users.
            Hostinger also offers a simple and modern dashboard.
          </p>
        </section>

        <section class="compare-section">
          <h2>Final Verdict</h2>
          <p>
            If you want better value and performance, Hostinger is often the better choice.
            Bluehost is a solid option for beginners.
          </p>

          <div class="compare-bottom-cta">
            <a
              href="/go/hostinger"
              class="btn btn-primary"
              target="_blank"
              rel="nofollow sponsored noopener"
            >
              Choose Hostinger →
            </a>
          </div>
        </section>

        <section class="compare-section compare-faq-section">
          <h2>Comparison FAQ</h2>
          <div class="compare-faq-list">
            {faqItems.map((item) => (
              <details class="compare-faq-item">
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </section>

      </article>

      <aside class="compare-sidebar">
        <div class="compare-sidebar-box">
          <h3>Quick Summary</h3>
          <ul>
            <li>Hostinger is cheaper</li>
            <li>Bluehost is beginner-friendly</li>
            <li>Both support WordPress</li>
          </ul>
        </div>

        <div class="compare-sidebar-box">
          <h3>Read Next</h3>
          {currentGuides.length > 0 && (
            <ul class="compare-sidebar-links">
              {currentGuides.map((item) => (
                <li>
                  <a href={`/${currentCategory}/${item.slug}`}>
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class="compare-sidebar-box">
          <h3>Best Choice</h3>
          <p>
            For most users, Hostinger offers the best balance of price and performance.
          </p>
          <a
            href="/go/hostinger"
            class="btn btn-primary compare-sidebar-btn"
            target="_blank"
            rel="nofollow sponsored noopener"
          >
            Get Hostinger →
          </a>
        </div>
      </aside>
    </div>
  </section>
</Layout>
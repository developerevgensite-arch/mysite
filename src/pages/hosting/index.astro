---
// Category page (hosting)
// Shows list of hosting providers with links to reviews and affiliate buttons
// Used for /hosting and similar category pages

import Layout from "../../layouts/Layout.astro";
import reviews from "../../data/reviews.json";
import { guides as hostingGuides } from "../../data/guides.js";

const hostingReviews = reviews
  .filter((review) => review.category === "hosting")
  .sort((a, b) => b.rating - a.rating);
// faq
const faqItems = [
  {
    q: "What type of hosting should I choose?",
    a: "For most new websites, shared hosting is the cheapest start. If you expect steady traffic growth, choose managed WordPress hosting. For performance and full control, VPS or cloud hosting is the best upgrade."
  },
  {
    q: "How much does web hosting cost per month?",
    a: "Entry plans are often $2–$6/month on long-term deals. Managed WordPress and cloud hosting are usually $10–$30+/month. Renewal prices can be higher than the first-term promo."
  },
  {
    q: "Do I need a domain name to buy hosting?",
    a: "Not necessarily. Many hosts let you start without a domain and connect it later. If you already own a domain, you can point DNS to your hosting provider in a few minutes."
  },
  {
    q: "What matters most for speed and SEO: servers or WordPress plugins?",
    a: "Both, but hosting sets the baseline. Fast PHP/CPU, SSD storage, good caching and a nearby datacenter help the most. Plugins can optimize images and caching, but they can’t fully fix slow servers."
  },
  {
    q: "Is “free SSL” important?",
    a: "Yes. SSL (HTTPS) is required for trust and basic security, and it’s a standard expectation for modern websites. Most good hosts include a free Let’s Encrypt SSL."
  },
  {
    q: "Can I migrate my website to another host later?",
    a: "Yes. You can usually migrate by copying files and databases or using a migration plugin. Many providers offer free migration for WordPress sites, which makes switching easier."
  }
];

const guides = hostingGuides.hosting ?? [];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a
    }
  }))
};
---

<Layout title="Best Web Hosting Services">

<section class="category-hero">

<h1>Best Web Hosting Services</h1>

<p class="category-text">
  Looking for the best web hosting? We tested popular providers like Hostinger, Bluehost and Cloudways to help you choose the right one for your website.
</p>

</section>

<section class="tools-grid">

  {hostingReviews.map((item) => (
    <article class="tool-card">
  
      {item.badge && <div class="card-badge">{item.badge}</div>}
  
      <h2>{item.name}</h2>
  
      {item.tag && <p class="card-tag">{item.tag}</p>}
  
      <p>{item.description}</p>
    <div class="tool-meta">
      <span class="rating">⭐ {item.rating} / 5 (Our score)</span>
    </div>
<div class="buttons">

<a href={`/hosting/${item.slug}`} class="btn btn-secondary">
  Read Review →
</a>

<a href={item.affiliate} class="btn btn-primary" target="_blank" rel="nofollow sponsored noopener">
  Check Price →
</a>

</div>

  </article>
))}

</section>

<section class="container-text">

  <h2>How to Choose the Best Hosting</h2>
  
  <p>
  Choosing the right hosting depends on your goals. If you're starting a new website,
  you need something simple and affordable. If you already have traffic, performance
  and reliability become more important.
  </p>
  
  <p>
  We tested the most popular hosting providers and selected the best options for
  different use cases: beginners, performance, and budget.
  </p>
  
</section>

  <section class="container-text">

    <h2>Best Hosting by Use Case</h2>
    
    <ul class="use-cases">
      <li><strong>Best overall value:</strong> Hostinger — easy to use and affordable</li>
      <li><strong>Best performance:</strong> Cloudways — powerful cloud hosting</li>
      <li><strong>Best budget option:</strong> InterServer — low cost with solid features</li>
    </ul>
    
  </section>  

  

<!-- faq -->
<section class="faq" aria-label="Hosting FAQ">
  <div class="faq-inner">
    <h2>Hosting FAQ</h2>
    <p class="faq-subtitle">
      Quick answers to common questions about choosing web hosting.
    </p>

    <div class="faq-list">
      {faqItems.map((item) => (
        <details class="faq-item">
          <summary class="faq-question">
            <span>{item.q}</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-answer">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- <div class="guide-link-wrap">
  <a href="/hosting/best-hosting" class="guide-link-btn">
    View Full Hosting Guide →
  </a>
</div>   -->

<section class="guides-section-box">

  <div class="faq-inner">

    <h2>Hosting Guides</h2>

    <div class="guides-grid">
      {guides.map((item) => (
        <a href={`/hosting/${item.slug}/`} class="guide-card">
          <h3>{item.title}</h3>
          <span>Read Guide →</span>
        </a>
      ))}
    </div>
  </div>
</section>


<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

<style>

.category-hero{
max-width:900px;
margin:auto;
padding:20px 20px 10px;
text-align:left;
}

.category-subtitle,.category-text {
font-size:18px;
color:#555;
margin-top:10px;
}

.card-tag{
  font-size:14px;
  color:#ff8a00;
  font-weight:600;
  margin-bottom:6px;
}

.card-badge{
  position:absolute;
  top:12px;
  right:12px;
  background:#22c55e;
  color:#fff;
  padding:5px 9px;
  font-size:12px;
  font-weight: 600;
  border-radius:6px;
}

.tools-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
gap:20px;
margin:20px auto 40px;
max-width:1000px;
padding:0 20px;
}

.tool-card{
  position:relative;
background:#fff;
border-radius:12px;
padding:20px;
box-shadow:0 5px 20px rgba(0,0,0,0.04);
display:flex;
flex-direction:column;
gap:10px;
}

.tool-meta{
font-size:14px;
color:#444;
}

.rating{
font-weight:bold;
color:#2e7d32;
}

.btn{
  margin-top:auto;
  align-self:flex-start;
}


.container-text{
  max-width:900px;
  margin:0 auto 30px;
  padding:0 20px;
}

.use-cases{
  margin-top:10px;
  line-height:1.8;
  color:#444;
}

.buttons{
  margin-top:auto;
  display:flex;
  flex-direction:column;
  gap:10px;
}




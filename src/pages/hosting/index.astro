/* faq */
.faq{
max-width:1000px;
margin:0 auto 40px;
padding:0 20px;
}

.faq-inner{
background:white;
border-radius:12px;
box-shadow:0 5px 20px rgba(0,0,0,0.04);
padding:22px;
}

.faq-inner h2{
margin-top:0;
margin-bottom:10px;
}

.faq-subtitle{
margin:0 0 18px;
font-size:16px;
color:#555;
max-width:760px;
}

.faq-list{
display:flex;
flex-direction:column;
gap:10px;
}

.faq-item{
border:1px solid #eceff3;
border-radius:10px;
background:#fff;
overflow:hidden;
}

.faq-question{
list-style:none;
display:flex;
align-items:center;
justify-content:space-between;
gap:16px;
padding:14px 16px;
cursor:pointer;
font-weight:700;
color:#111827;
}

.faq-question::-webkit-details-marker{
display:none;
}

.faq-icon{
width:28px;
height:28px;
border-radius:8px;
display:grid;
place-items:center;
background:#fff2e5;
color:#b45309;
font-weight:800;
flex:0 0 auto;
transition:transform .15s ease;
}

.faq-item[open] .faq-icon{
transform:rotate(45deg);
}

.faq-answer{
padding:0 16px 16px;
color:#4b5563;
}

.faq-answer p{
margin:0;
}


/* ссылки внизу страниц категори /hosting и аналогичных */
.guides-section-box{
  max-width:1000px;
  margin:80px auto 0px;
  padding:20px 20px;
  /* background:#fff; */
  border-radius:12px;
  /* box-shadow:0 5px 10px rgba(0,0,0,0.04); */
}

.guides-section-box h2{
  margin-top:0;
}

.guides-section{
  max-width:1000px;
  margin:40px auto;
  padding:0 20px;
}

.guides-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:16px;
  margin-top:20px;
}

.guide-card{
  background:#f9fafb;
  padding:18px;
  border-radius:10px;
  text-decoration:none;
  color:#111;
  border:1px solid #eef1f5;
  transition:0.2s;
}

.guide-card:hover{
  background:#fff;
  transform:translateY(-3px);
  box-shadow:0 8px 20px rgba(0,0,0,0.06);
}

.guide-card h3{
  margin:0 0 8px;
  font-size:16px;
}

.guide-card span{
  color:#ff8a00;
  font-weight:600;
  font-size:14px;
}


</style>

</Layout>

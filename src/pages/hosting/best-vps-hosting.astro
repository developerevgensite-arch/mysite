---
import Layout from "../../layouts/Layout.astro";
import "../../styles/compare-pages.css"; 
import reviews from "../../data/reviews.json";
import { guides } from "../../data/guides.js";

const pathname = Astro.url.pathname.split("/").filter(Boolean);

const currentCategory = pathname[0] || "";
const currentSlug = pathname[1] || "";

const currentGuides = (guides[currentCategory] ?? [])
  .filter((item) => item.slug !== currentSlug)
  .slice(0, 4);

const categoryReviews = reviews
  .filter((item) => item.category === currentCategory)
  .sort((a, b) => (b.rating || 0) - (a.rating || 0));

const topItems = categoryReviews.slice(0, 2);

const faqItems = [
  {
    q: "What is VPS hosting?",
    a: "VPS (Virtual Private Server) hosting gives you dedicated resources on a virtual server. It offers more power and control than shared hosting."
  },
  {
    q: "Who should use VPS hosting?",
    a: "VPS hosting is ideal for growing websites, eCommerce stores, and users who need better performance and more control."
  },
  {
    q: "Is VPS hosting better than shared hosting?",
    a: "Yes, VPS offers better performance and stability, but it is usually more expensive."
  },
  {
    q: "Do I need technical skills for VPS hosting?",
    a: "Not necessarily. Many providers offer managed VPS hosting which is beginner-friendly."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout
  title="Best VPS Hosting in 2026"
  description="Compare the best VPS hosting providers for performance, scalability, and control. Find the right VPS for your website."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

  <section class="compare-hero">
    <div class="page-container">
      <p class="compare-eyebrow">Hosting Guide</p>
      <h1>Best VPS Hosting in 2026</h1>
      <p class="compare-intro">
        Need more power than shared hosting? VPS hosting gives you better performance,
        scalability, and control. We tested popular providers to help you choose the
        best VPS hosting for your website or business.
      </p>

      <div class="compare-cta-row">
        <a href="#top-picks" class="btn btn-primary">See Top Picks</a>
        {topItems[0] && (
          <a href={`/${topItems[0].category}/${topItems[0].slug}`} class="btn btn-secondary">
            Read {topItems[0].name} Review →
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="compare-content">
    <div class="page-container compare-layout">
      <article class="compare-main">

        <section class="compare-section">
          <h2>How to Choose VPS Hosting</h2>
          <p>
            VPS hosting is a step up from shared hosting. It gives you dedicated resources,
            better speed, and more stability. This makes it a great choice for growing websites.
          </p>
          <p>
            When choosing a VPS provider, focus on performance, scalability, ease of use,
            and support. Managed VPS hosting is ideal if you don’t want to handle server setup.
          </p>
          <p>
            If your website is getting more traffic or you need more control, upgrading to VPS
            is a smart move.
          </p>
        </section>

        <section class="compare-section" id="top-picks">
          <h2>Our Top {currentCategory.replace("-", " ")} Picks</h2>
          <p class="compare-note">
            These providers offer the best VPS performance and reliability.
          </p>

          <div class="compare-cards-grid">
            {topItems.map((item, index) => (
              <div class="compare-card">
                {index === 0 && <span class="compare-badge">Top Pick</span>}
                <h3>{item.name}</h3>
                <p class="compare-card-tag">{item.tag || "VPS hosting provider"}</p>
                <p class="compare-card-text">
                  {item.summary || item.description}
                </p>
                <div class="compare-rating">★ {item.rating}/5</div>

                <div class="compare-card-actions">
                  <a href={`/${item.category}/${item.slug}`} class="btn btn-secondary">
                    Read {item.name} Review →
                  </a>
                  {item.affiliate ? (
                    <a
                      href={item.affiliate}
                      class="btn btn-primary"
                      target="_blank"
                      rel="nofollow sponsored noopener"
                    >
                      Check Price →
                    </a>
                  ) : (
                    <span class="btn btn-primary disabled" aria-disabled="true">Link coming soon</span>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="compare-section">
          <h2>Best VPS Hosting by Use Case</h2>
          <ul class="compare-list">
            <li><strong>Best overall:</strong> Cloudways — flexible cloud VPS platform</li>
            <li><strong>Best for beginners:</strong> Hostinger — easy VPS setup</li>
            <li><strong>Best budget VPS:</strong> InterServer — affordable plans</li>
          </ul>
          <p>
            VPS hosting is perfect for websites that have outgrown shared hosting.
            It provides more control, better performance, and scalability.
          </p>
        </section>

        <section class="compare-section">
          <h2>Final Verdict</h2>
          <p>
            If you want flexibility and performance, Cloudways is one of the best VPS hosting
            platforms available. For beginners, Hostinger offers a simple and affordable VPS setup.
          </p>
          <p>
            The best VPS hosting depends on your needs — choose based on your budget,
            technical skills, and expected traffic.
          </p>

          <div class="compare-bottom-cta">
            <span class="btn btn-primary disabled" aria-disabled="true">Link coming soon</span>
          </div>
        </section>

        <section class="compare-section compare-faq-section">
          <h2>VPS Hosting FAQ</h2>
          <div class="compare-faq-list">
            {faqItems.map((item) => (
              <details class="compare-faq-item">
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </section>

      </article>

      <aside class="compare-sidebar">
        <div class="compare-sidebar-box">
          <h3>Quick Summary</h3>
          <ul>
            <li>Better than shared hosting</li>
            <li>More power and control</li>
            <li>Ideal for growing websites</li>
          </ul>
        </div>

        <div class="compare-sidebar-box">
          <h3>Read Next</h3>
          {currentGuides.length > 0 && (
            <ul class="compare-sidebar-links">
              {currentGuides.map((item) => (
                <li>
                  <a href={`/${currentCategory}/${item.slug}`}>
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class="compare-sidebar-box">
          <h3>Best Upgrade</h3>
          <p>
            Upgrade to VPS hosting when your site needs more speed and stability.
          </p>
          <span class="btn btn-primary compare-sidebar-btn disabled" aria-disabled="true">Link coming soon</span>
        </div>
      </aside>
    </div>
  </section>
</Layout>

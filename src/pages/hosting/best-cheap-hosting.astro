---
import Layout from "../../layouts/Layout.astro";
import "../../styles/compare-pages.css"; 
import reviews from "../../data/reviews.json";
import { guides } from "../../data/guides.js";

const pathname = Astro.url.pathname.split("/").filter(Boolean);

const currentCategory = pathname[0] || "";
const currentSlug = pathname[1] || "";

const currentGuides = (guides[currentCategory] ?? [])
  .filter((item) => item.slug !== currentSlug)
  .slice(0, 4);

const categoryReviews = reviews
  .filter((item) => item.category === currentCategory)
  .sort((a, b) => (b.rating || 0) - (a.rating || 0));

const topItems = categoryReviews.slice(0, 2);

const faqItems = [
  {
    q: "What is the cheapest hosting option?",
    a: "Shared hosting is usually the cheapest option. Providers like Hostinger and InterServer offer very low entry prices, especially with long-term plans."
  },
  {
    q: "Is cheap hosting reliable?",
    a: "Cheap hosting can be reliable for small websites and blogs. However, performance and support quality can vary, so it’s important to choose a trusted provider."
  },
  {
    q: "Why is hosting so cheap at first?",
    a: "Many hosting providers offer low introductory prices to attract new users. Renewal prices are usually higher, so always check long-term costs."
  },
  {
    q: "Can I upgrade cheap hosting later?",
    a: "Yes. Most hosting providers allow you to upgrade from shared hosting to VPS or cloud hosting as your website grows."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout
  title="Best Cheap Hosting in 2026"
  description="Looking for cheap hosting? Compare the best affordable hosting providers with good performance, pricing, and reliability."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

  <section class="compare-hero">
    <div class="page-container">
      <p class="compare-eyebrow">Hosting Guide</p>
      <h1>Best Cheap Hosting in 2026</h1>
      <p class="compare-intro">
        Looking for affordable web hosting without sacrificing performance? We reviewed
        the most popular budget hosting providers to help you find the best value for your money.
        This guide is perfect for beginners, bloggers, and small websites on a budget.
      </p>

      <div class="compare-cta-row">
        <a href="#top-picks" class="btn btn-primary">See Top Picks</a>
        {topItems[0] && (
          <a href={`/${topItems[0].category}/${topItems[0].slug}`} class="btn btn-secondary">
            Read {topItems[0].name} Review →
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="compare-content">
    <div class="page-container compare-layout">
      <article class="compare-main">

        <section class="compare-section">
          <h2>How to Choose Cheap Hosting</h2>
          <p>
            Cheap hosting does not always mean bad quality. Many providers offer low prices
            for new users, making it possible to launch a website with minimal investment.
          </p>
          <p>
            The most important factors to consider are renewal pricing, performance,
            uptime, and customer support. A cheap plan is only worth it if your website
            remains stable and fast.
          </p>
          <p>
            For beginners, shared hosting is usually the best choice. It is affordable,
            easy to use, and enough for most small websites.
          </p>
        </section>

        <section class="compare-section" id="top-picks">
          <h2>Our Top {currentCategory.replace("-", " ")} Picks</h2>
          <p class="compare-note">
            These providers offer the best balance between price and performance.
          </p>

          <div class="compare-cards-grid">
            {topItems.map((item, index) => (
              <div class="compare-card">
                {index === 0 && <span class="compare-badge">Best Value</span>}
                <h3>{item.name}</h3>
                <p class="compare-card-tag">{item.tag || "Affordable hosting"}</p>
                <p class="compare-card-text">
                  {item.summary || item.description}
                </p>
                <div class="compare-rating">★ {item.rating}/5</div>

                <div class="compare-card-actions">
                  <a href={`/${item.category}/${item.slug}`} class="btn btn-secondary">
                    Read {item.name} Review →
                  </a>
                  {item.affiliate ? (
                    <a
                      href={item.affiliate}
                      class="btn btn-primary"
                      target="_blank"
                      rel="nofollow sponsored noopener"
                    >
                      Check Price →
                    </a>
                  ) : (
                    <span class="btn btn-primary disabled" aria-disabled="true">Link coming soon</span>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="compare-section">
          <h2>Best Cheap Hosting by Use Case</h2>
          <ul class="compare-list">
            <li><strong>Best overall value:</strong> Hostinger — low prices and good performance</li>
            <li><strong>Best budget option:</strong> InterServer — stable and affordable plans</li>
            <li><strong>Best for flexibility:</strong> Cloudways — scalable cloud hosting</li>
          </ul>
          <p>
            Cheap hosting is ideal for blogs, portfolios, and small business websites.
            As your project grows, you can always upgrade to more powerful hosting.
          </p>
        </section>

        <section class="compare-section">
          <h2>Final Verdict</h2>
          <p>
            If you want the best cheap hosting, Hostinger is one of the strongest choices
            thanks to its combination of price and performance. InterServer is also a solid
            option for users looking for stable low-cost hosting.
          </p>
          <p>
            The best cheap hosting is not just about price — it should also offer reliability,
            support, and room to grow as your website expands.
          </p>

          <div class="compare-bottom-cta">
            <a
              href="/go/hostinger"
              class="btn btn-primary"
              target="_blank"
              rel="nofollow sponsored noopener"
            >
              Get Cheap Hosting →
            </a>
          </div>
        </section>

        <section class="compare-section compare-faq-section">
          <h2>Cheap Hosting FAQ</h2>
          <div class="compare-faq-list">
            {faqItems.map((item) => (
              <details class="compare-faq-item">
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </section>

      </article>

      <aside class="compare-sidebar">
        <div class="compare-sidebar-box">
          <h3>Quick Summary</h3>
          <ul>
            <li>Best cheap hosting providers</li>
            <li>Low price with good performance</li>
            <li>Perfect for beginners</li>
          </ul>
        </div>

        <div class="compare-sidebar-box">
          <h3>Read Next</h3>
          {currentGuides.length > 0 && (
            <ul class="compare-sidebar-links">
              {currentGuides.map((item) => (
                <li>
                  <a href={`/${currentCategory}/${item.slug}`}>
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class="compare-sidebar-box">
          <h3>Best Deal</h3>
          <p>
            Start with a cheap hosting plan and upgrade later as your site grows.
          </p>
          <a
            href="/go/hostinger"
            class="btn btn-primary compare-sidebar-btn"
            target="_blank"
            rel="nofollow sponsored noopener"
          >
            Check Deals →
          </a>
        </div>
      </aside>
    </div>
  </section>
</Layout>

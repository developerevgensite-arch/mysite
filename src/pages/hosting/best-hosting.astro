---
import Layout from "../../layouts/Layout.astro";
import reviews from "../../data/reviews.json";

const hostingReviews = reviews
  .filter((item) => item.category === "hosting")
  .sort((a, b) => (b.rating || 0) - (a.rating || 0));

const topHosting = hostingReviews.slice(0, 2);

const faqItems = [
  {
    q: "What is the best hosting for beginners?",
    a: "For most beginners, the best hosting is a provider with simple setup, good performance, fair pricing, and reliable support. Hostinger is often a strong option for first websites."
  },
  {
    q: "Is cheap hosting good enough?",
    a: "Cheap hosting can be good enough for blogs, portfolio sites, and small business websites if the provider offers stable uptime, acceptable speed, and helpful support."
  },
  {
    q: "Should I choose shared hosting or VPS?",
    a: "Shared hosting is usually the best starting point for beginners because it is cheaper and easier to manage. VPS is better when you need more power and technical control."
  },
  {
    q: "How do I choose the best hosting provider?",
    a: "Compare pricing, performance, uptime, ease of use, support quality, and renewal costs. It is also important to choose a provider that fits your website type and budget."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout
  title="Best Hosting in 2026"
  description="Compare the best hosting providers for beginners, small websites, and growing projects. See our top picks, pros, and quick answers before choosing a host."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

  <section class="guide-hero">
    <div class="guide-wrap">
      <p class="guide-eyebrow">Hosting Guide</p>
      <h1>Best Hosting in 2026</h1>
      <p class="guide-intro">
        Looking for the best hosting for your website? We reviewed popular providers
        and selected the top options based on ease of use, performance, value, and
        overall reliability. This guide is designed for beginners, bloggers, small
        business owners, and anyone launching a new website.
      </p>

      <div class="guide-cta-row">
        <a href="#top-picks" class="btn btn-primary">See Top Picks</a>
        <a href="/hosting/hostinger" class="btn btn-secondary">Read Hostinger Review</a>
      </div>
    </div>
  </section>

  <section class="guide-content">
    <div class="guide-wrap guide-grid">
      <article class="main-content">
        <section class="content-card">
          <h2>How to Choose the Best Hosting</h2>
          <p>
            Choosing the best hosting depends on your website goals. A personal blog
            or starter business site usually needs affordable shared hosting with an
            easy dashboard and solid support. A growing project may need better speed,
            backups, staging tools, and stronger uptime.
          </p>
          <p>
            The most important things to compare are pricing, renewal cost,
            performance, control panel simplicity, customer support, and whether the
            provider is beginner-friendly. A cheap plan is not always the best value
            if support is poor or the site becomes slow under normal traffic.
          </p>
          <p>
            For most new website owners, it is smarter to choose a reliable provider
            that is easy to manage rather than the most advanced technical option.
            You can always upgrade later as your site grows.
          </p>
        </section>

        <section class="content-card" id="top-picks">
          <h2>Our Top Hosting Picks</h2>
          <p class="section-note">
            These are the main providers currently featured on the site.
          </p>

          <div class="hosting-cards">
            {topHosting.map((item, index) => (
              <div class="hosting-card">
                {index === 0 && <span class="card-badge">Top Pick</span>}
                <h3>{item.name}</h3>
                <p class="card-tag">{item.tag || "Reliable hosting provider"}</p>
                <p class="card-summary">
                  {item.summary || item.description}
                </p>
                <div class="card-rating">★ {item.rating}/5</div>

                <div class="card-actions">
                  <a href={`/${item.category}/${item.slug}`} class="btn btn-secondary">
                    Read Review →
                  </a>
                  <a
                    href={item.affiliate}
                    class="btn btn-primary"
                    target="_blank"
                    rel="nofollow sponsored noopener"
                  >
                    Check Price →
                  </a>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="content-card">
          <h2>Best Hosting by Use Case</h2>
          <ul class="use-case-list">
            <li><strong>Best for beginners:</strong> Hostinger — simple setup and good value.</li>
            <li><strong>Best for growing projects:</strong> Cloudways — flexible performance options.</li>
            <li><strong>Best budget choice:</strong> InterServer — stable low-cost plans.</li>
          </ul>
          <p>
            Different users need different things. Beginners usually care about price
            and simplicity, while businesses care more about uptime, speed, security,
            and support. That is why comparison pages and detailed reviews are useful
            before making a final decision.
          </p>
        </section>

        <section class="content-card">
          <h2>Final Verdict</h2>
          <p>
            If you want a simple and affordable place to start, Hostinger is one of
            the strongest choices for beginners. If your priority is flexibility and
            scaling, Cloudways may be a better fit. If you want a budget-focused
            option, InterServer is also worth considering.
          </p>
          <p>
            The best hosting is not always the most expensive one. The right choice is
            the provider that matches your budget, website type, and level of
            experience.
          </p>

          <div class="bottom-cta">
            <a
              href="/go/hostinger"
              class="btn btn-primary"
              target="_blank"
              rel="nofollow sponsored noopener"
            >
              Visit Hostinger →
            </a>
          </div>
        </section>

        <section class="content-card faq-card">
          <h2>Hosting FAQ</h2>
          <div class="faq-list">
            {faqItems.map((item) => (
              <details class="faq-item">
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </section>
      </article>

      <aside class="sidebar">
        <div class="sidebar-card">
          <h3>Quick Summary</h3>
          <ul>
            <li>Compare hosting providers in one place</li>
            <li>Useful for beginners and small websites</li>
            <li>Includes reviews and pricing links</li>
          </ul>
        </div>

        <div class="sidebar-card">
          <h3>Read Next</h3>
          <ul class="sidebar-links">
            <li><a href="/hosting/hostinger">Hostinger Review</a></li>
            <li><a href="/hosting/interserver">InterServer Review</a></li>
            <li><a href="/hosting/cloudways">Cloudways Review</a></li>
            <li><a href="/hosting/bluehost">Bluehost Review</a></li>
          </ul>
        </div>

        <div class="sidebar-card">
          <h3>Best Starting Point</h3>
          <p>
            New to websites? Start with a beginner-friendly host and upgrade later.
          </p>
          <a
            href="/go/hostinger"
            class="btn btn-primary sidebar-btn"
            target="_blank"
            rel="nofollow sponsored noopener"
          >
            Check Hostinger →
          </a>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .guide-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .guide-hero {
    padding: 70px 0 30px;
    background: linear-gradient(180deg, #f5f7fb 0%, #ffffff 100%);
  }

  .guide-eyebrow {
    color: #ff8a00;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }

  .guide-hero h1 {
    font-size: 42px;
    line-height: 1.15;
    margin: 0 0 18px;
    color: #1f2937;
  }

  .guide-intro {
    max-width: 760px;
    font-size: 18px;
    line-height: 1.75;
    color: #4b5563;
    margin: 0 0 26px;
  }

  .guide-cta-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .guide-content {
    padding: 20px 0 60px;
    background: #ffffff;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
    gap: 28px;
    align-items: start;
  }

  .content-card,
  .sidebar-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    padding: 26px;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
    margin-bottom: 24px;
  }

  .content-card h2,
  .sidebar-card h3 {
    margin-top: 0;
    color: #1f2937;
  }

  .content-card p,
  .sidebar-card p,
  .content-card li,
  .sidebar-card li {
    color: #4b5563;
    line-height: 1.75;
  }

  .section-note {
    margin-top: -8px;
    margin-bottom: 20px;
    color: #6b7280;
  }

  .hosting-card{
  position: relative;
  border: 1px solid #e5e7eb;
  border-radius: 16px;
  padding: 20px;
  background: #f9fafb;

  display: flex;
  flex-direction: column;
  height: 100%; /* 🔥 ВАЖНО */
}

.hosting-card .btn{
  display: block;
  width: 100%;
  min-width: 0;              /* 🔥 перебивает global.css */
  box-sizing: border-box;    /* 🔥 чтобы padding не раздувал кнопку */
  text-align: center;
  align-self: stretch;
  padding: 12px 16px;        /* чуть компактнее */
  font-size: 15px;           /* чуть меньше, чтобы лучше влезало */
}

.hosting-card .card-actions{
  margin-top: auto;
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: 100%;
  align-items: stretch;
}

.hosting-cards{
  display: grid;
  grid-template-columns: repeat(2, minmax(0px, 1fr));
  gap: 16px;
  align-items: stretch;
}

  .card-badge {
    display: inline-block;
    margin-bottom: 12px;
    background: #ff8a00;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    padding: 6px 10px;
    border-radius: 999px;
  }

  .hosting-card h3 {
    margin: 0 0 8px;
    color: #1f2937;
  }

  .card-tag {
    color: #ff8a00;
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .card-summary {
    font-size: 15px;
    min-height: 96px;
  }

  .card-rating {
    font-weight: 700;
    color: #1f2937;
    margin: 14px 0 18px;
  }

 

 

  .use-case-list {
    padding-left: 20px;
  }

  .bottom-cta {
    margin-top: 22px;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 14px 16px;
    background: #f9fafb;
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: 700;
    color: #1f2937;
  }

  .faq-item p {
    margin: 12px 0 0;
  }

  .sidebar ul {
    margin: 0;
    padding-left: 18px;
  }

  .sidebar-links {
    padding-left: 18px;
  }

  .sidebar-links a {
    color: #1e3a8a;
    text-decoration: none;
  }

  .sidebar-links a:hover {
    text-decoration: underline;
  }

  .sidebar-btn {
    width: 100%;
    margin-top: 10px;
  }

  @media (max-width: 980px) {
    .guide-grid {
      grid-template-columns: 1fr;
    }

    .hosting-cards {
      grid-template-columns: 1fr;
    }

    .guide-hero h1 {
      font-size: 34px;
    }

    .guide-intro {
      font-size: 17px;
    }
  }

  @media (max-width: 640px) {
    .guide-hero {
      padding: 56px 0 20px;
    }

    .guide-hero h1 {
      font-size: 28px;
    }

    .guide-intro {
      font-size: 16px;
    }

    .content-card,
    .sidebar-card {
      padding: 20px;
    }

    .guide-cta-row {
      flex-direction: column;
    }

    .btn {
      width: 100%;
  text-align: center;
    }
  }
</style>
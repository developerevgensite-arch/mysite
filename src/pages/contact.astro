---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact - TechReview"
  description="Contact TechReview for questions, feedback, corrections, or partnership inquiries."
>

<section class="contact-page">

  <header class="contact-hero">
    <h1>Contact</h1>
    <p class="lead">
      Have a question about a review, want to suggest a tool, or spotted something that needs an update?
      Send us a message and we’ll get back to you.
    </p>
  </header>

  <div class="contact-grid">

    <section class="card" aria-label="Contact information">
      <h2>Contact Information</h2>

      <div class="info">
        <div class="info-row">
          <div class="label">Email</div>
          <div class="value">
            <a class="cta-link" href="mailto:contact@techtoolreviews.com">contact@techtoolreviews.com</a>
            
          </div>
        </div>

        <div class="info-row">
          <div class="label">Response time</div>
          <div class="value">
            1–3 business days
            <div class="hint">We answer in the order messages are received.</div>
          </div>
        </div>

        <div class="info-row">
          <div class="label">For partnerships</div>
          <div class="value">
            Please include your website/app name, a short description, and the offer details.
            <div class="hint">We do not sell “pay-for-review” placements.</div>
          </div>
        </div>
      </div>
    </section>

    <section class="card" aria-label="Contact form">
      <h2>Send a message</h2>

      <form class="form" method="post" action="#">
        <label class="field">
          <span class="field-label">Your name</span>
          <input class="input" type="text" name="name" placeholder="Jane Doe" autocomplete="name" />
        </label>

        <label class="field">
          <span class="field-label">Email</span>
          <input class="input" type="email" name="email" placeholder="jane@example.com" autocomplete="email" />
        </label>

        <label class="field">
          <span class="field-label">Topic</span>
          <select class="input" name="topic">
            <option value="question">Question about a review</option>
            <option value="correction">Correction / update</option>
            <option value="suggestion">Suggest a tool</option>
            <option value="partnership">Partnership inquiry</option>
            <option value="other">Other</option>
          </select>
        </label>

        <label class="field">
          <span class="field-label">Message</span>
          <textarea class="input textarea" name="message" rows="6" placeholder="Write your message here..."></textarea>
        </label>

        <button class="btn" type="submit" disabled aria-disabled="true" title="Placeholder form">
          Send Message
        </button>
      </form>
      <p class="form-note">
        By submitting this form, you agree to our 
        <a href="/privacy-policy">Privacy Policy</a>.
      </p>
    </section>

  </div>

</section>

<style>

.contact-page{
  max-width:1000px;
  margin:40px auto 60px;
  padding:0 20px;
}

.contact-hero{
  text-align:center;
  margin-bottom:26px;
}

.contact-hero h1{
  font-size:36px;
  margin-bottom:12px;
}

.lead{
  font-size:18px;
  color:#555;
  max-width:820px;
  margin:0 auto;
}

.contact-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
  align-items:start;
}

.card{
  background:white;
  border-radius:12px;
  box-shadow:0 10px 25px rgba(0,0,0,0.06);
  padding:22px;
}

/* MOBILE CENTER FORM */
@media (max-width:768px){

.card{
  max-width:500px;
  margin:0 auto;
}

}

.card h2{
  margin-top:0;
  margin-bottom:10px;
  font-size:22px;
}

.subtitle{
  margin:0 0 16px;
  color:#555;
  font-size:15px;
}

.info{
  display:flex;
  flex-direction:column;
  gap:14px;
}

.info-row{
  display:grid;
  grid-template-columns:140px 1fr;
  gap:14px;
  padding:12px 0;
  border-bottom:1px solid #eee;
}

.info-row:last-child{
  border-bottom:none;
}

.label{
  font-weight:700;
  color:#111827;
}

.value{
  color:#444;
}

.hint{
  margin-top:6px;
  font-size:13px;
  color:#777;
}

.form{
  display:flex;
  flex-direction:column;
  gap:12px;
}

.field{
  display:flex;
  flex-direction:column;
  gap:6px;
}

.field-label{
  font-weight:700;
  color:#111827;
  font-size:14px;
}

.input{
  width:100%;
  border:1px solid #e5e7eb;
  border-radius:10px;
  padding:12px 12px;
  font-size:15px;
  outline:none;
  background:white;
  color:#111827;
}

.input:focus{
  border-color:#ff8a00;
  box-shadow:0 0 0 3px rgba(255,138,0,0.18);
}

.textarea{
  resize:vertical;
}

.cta-link{
  color:var(--cta);
  font-weight:600;
}

.cta-link:hover{
  color:var(--cta-hover);
  text-decoration:underline;
}

.form-note{
  font-size:12px;
  color:#6b7280;
  margin-top:10px;
  line-height:1.4;
}

.form-note a{
  color:#ff8a00;
  text-decoration:none;
}

.form-note a:hover{
  text-decoration:underline;
}


@media (max-width:900px){
  .contact-grid{
    grid-template-columns:1fr;
  }
}

@media (max-width:768px){
  .contact-page{
    margin:30px auto 50px;
    padding:0 16px;
  }

  .contact-hero h1{
    font-size:28px;
  }

  .info-row{
    grid-template-columns:1fr;
  }
}

</style>

</Layout>
